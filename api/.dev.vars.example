# Copy this file to .dev.vars, then replace the values marked <required>.
OPENROUTER_API_KEY=<required>
GOOGLE_CLIENT_ID=<required>
GOOGLE_CLIENT_SECRET=<required>
AUTH_COOKIE_SECRET=<required>
# Set this to the API Key configured for the SePay webhook.
SEPAY_WEBHOOK_API_KEY=

# Non-secret settings such as model, pricing, CORS and receiving bank details live in src/config/app.ts.
