# Copy this file to .dev.vars, then replace the values marked <required>.
OPENROUTER_API_KEY=<required>
GOOGLE_CLIENT_ID=<required>
GOOGLE_CLIENT_SECRET=<required>
AUTH_COOKIE_SECRET=<required>
# PayOS: keep these blank when billing is not being tested locally.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Non-secret settings such as model, pricing, CORS and payment return URLs live in src/config/app.ts.
