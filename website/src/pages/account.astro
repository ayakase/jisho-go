---
import Layout from '../layouts/Layout.astro';

const apiBase = import.meta.env.PUBLIC_API_BASE_URL?.replace(/\/$/, '') ?? 'http://localhost:8787';
const historyUrl = `${apiBase}/history`;
const meUrl = `${apiBase}/auth/me`;
const logoutUrl = `${apiBase}/auth/logout`;
const walletUrl = `${apiBase}/billing/wallet`;
const checkoutUrl = `${apiBase}/billing/checkout`;
---

<Layout>
  <main class="app-shell text-base-content" data-history-url={historyUrl} data-me-url={meUrl} data-logout-url={logoutUrl} data-wallet-url={walletUrl} data-checkout-url={checkoutUrl}>
    <aside class="app-sidebar">
      <a href="/" class="mb-6 flex items-center gap-3 font-bold text-[#333333]">
        <span class="grid size-9 place-items-center rounded-lg border-2 border-[#fecaca] bg-[#ffe4e6] text-[#9f1239]">字</span>
        <span>Jisho Go</span>
      </a>
      <div id="user-area" class="mb-6 flex items-center gap-3 rounded-lg border border-base-300 bg-base-200 p-3">
        <div class="skeleton h-10 w-10 rounded-full"></div>
        <div class="min-w-0 space-y-2">
          <div class="skeleton h-4 w-32"></div>
          <div class="skeleton h-3 w-40"></div>
        </div>
      </div>
      <nav class="grid gap-1">
        <button data-tab="learning" type="button" class="sidebar-link tab-active">History</button>
        <button data-tab="wallet" type="button" class="sidebar-link">Ví AI</button>
      </nav>
      <div class="mt-6 grid gap-1 border-t border-base-300 pt-4">
        <a href="/" class="sidebar-link">Trang chủ</a>
        <button id="logout-btn" type="button" class="sidebar-link hidden">Logout</button>
      </div>
    </aside>

    <div class="app-main">
      <section id="wallet-section" data-panel="wallet" class="panel-surface hidden min-h-[calc(100vh-2rem)] rounded-xl p-5">
        <div class="grid gap-6">
          <div class="flex flex-wrap items-start justify-between gap-4">
            <div>
              <h1 class="text-3xl font-bold">Ví AI</h1>
            </div>
            <button id="wallet-refresh-btn" type="button" class="btn btn-outline btn-sm">Tải lại số dư</button>
          </div>

          <div class="wallet-overview-grid">
            <div class="wallet-balance-card">
              <p class="text-sm">Số dư hiện tại</p>
              <p id="wallet-balance" class="mt-2 text-4xl font-black">...</p>
              <p class="mt-2 text-sm">Phí AI được trừ sau mỗi lần phân tích thành công.</p>
            </div>
            <div class="wallet-topup-card">
              <div class="wallet-topup-layout">
                <div class="wallet-qr-column">
                  <img id="wallet-topup-qr" src="https://vietqr.app/img?bank=BIDV&amp;acc=96247OW8RC&amp;template=compact" alt="Mã QR chuyển khoản nạp tiền" width="220" height="220" class="wallet-qr-image" />
                  <a id="wallet-payment-link" class="btn btn-outline btn-sm mt-3 w-full" target="_blank" rel="noopener noreferrer">Mở mã QR</a>
                </div>
                <div class="wallet-topup-options">
                  <div class="flex flex-wrap items-start justify-between gap-3">
                    <div>
                      <h2 class="text-lg font-bold">Nạp tiền vào ví</h2>
                      <p class="mt-1 text-sm text-base-content/60">Chọn số tiền bạn muốn nạp.</p>
                    </div>
                    <span class="wallet-secure-label">SePay · Chuyển khoản</span>
                  </div>
                  <div id="wallet-products" class="wallet-product-grid mt-4"></div>
                  <p id="wallet-product-empty" class="hidden mt-3 text-sm text-base-content/60">Chưa có gói nạp.</p>
                </div>
              </div>
            </div>
          </div>

          <div id="wallet-error" class="alert alert-error hidden"></div>

          <div>
            <h2 class="text-sm font-semibold uppercase tracking-wide text-base-content/70">Lịch sử giao dịch</h2>
            <div id="wallet-entry-empty" class="hidden mt-3 alert">Chưa có giao dịch.</div>
            <div id="wallet-entry-table-wrap" class="hidden mt-3 overflow-x-auto rounded-box border border-base-300">
              <table class="table table-zebra">
                <thead>
                  <tr><th>Thời gian</th><th>Loại</th><th>Thay đổi</th><th>Số dư sau giao dịch</th></tr>
                </thead>
                <tbody id="wallet-entry-table-body"></tbody>
              </table>
            </div>
          </div>
        </div>
      </section>

      <section id="history-section" data-panel="learning" class="panel-surface min-h-[calc(100vh-2rem)] rounded-xl p-5">
        <div class="grid gap-5">
          <div class="flex flex-wrap items-start justify-between gap-4">
            <div>
              <h1 class="text-3xl font-bold">Learning History</h1>
            </div>
            <div id="account-stats" class="grid gap-2 text-sm"></div>
          </div>

          <div id="account-error" class="alert alert-error hidden"></div>
          <div id="account-empty" class="alert hidden">Chưa có lịch sử.</div>

          <form id="history-filters" class="grid gap-2 rounded-box border border-base-300 bg-base-200 p-3 xl:grid-cols-[minmax(0,1fr)_auto_auto_auto_auto]">
            <input id="history-query" type="search" class="input input-bordered min-w-0" placeholder="Tìm nội dung đã tra" />
            <input id="history-from" type="date" class="input input-bordered" aria-label="Từ ngày" />
            <input id="history-to" type="date" class="input input-bordered" aria-label="Đến ngày" />
            <label class="label cursor-pointer justify-start gap-2 px-1 text-sm"><input id="history-favorite" type="checkbox" class="checkbox checkbox-sm" /> Đã đánh dấu</label>
            <div class="flex gap-2">
              <button class="btn btn-primary btn-sm">Lọc</button>
              <button id="history-export" type="button" class="btn btn-outline btn-sm">CSV</button>
            </div>
          </form>
          <div id="history-export-options" class="hidden rounded-box border border-base-300 bg-base-200 p-4 text-sm"></div>

          <div id="account-table-wrap" class="hidden overflow-x-auto rounded-box border border-base-300">
            <table class="table table-zebra">
              <thead>
                <tr>
                  <th>Thời gian</th>
                  <th>Nội dung</th>
                  <th>Nghĩa</th>
                  <th>Trọng tâm</th>
                  <th>Nguồn</th>
                  <th>Đánh dấu</th>
                  <th>Bài học</th>
                </tr>
              </thead>
              <tbody id="account-table-body"></tbody>
            </table>
          </div>

          <nav id="history-pagination" class="mt-1 hidden items-center justify-between gap-3" aria-label="Phân trang lịch sử học">
            <p id="history-page-status" class="text-sm text-base-content/70"></p>
            <div class="flex items-center gap-2">
              <button id="history-prev-btn" type="button" class="btn btn-outline btn-sm">Trang trước</button>
              <button id="history-next-btn" type="button" class="btn btn-outline btn-sm">Trang sau</button>
            </div>
          </nav>
        </div>
      </section>
    </div>
  </main>
  <script is:inline>
    const mainEl = document.querySelector('main[data-history-url]');
    const historyUrl = mainEl ? mainEl.getAttribute('data-history-url') : '';
    const meUrl = mainEl ? mainEl.getAttribute('data-me-url') : '';
    const logoutUrl = mainEl ? mainEl.getAttribute('data-logout-url') : '';
    const walletUrl = mainEl ? mainEl.getAttribute('data-wallet-url') : '';
    const checkoutUrl = mainEl ? mainEl.getAttribute('data-checkout-url') : '';

    const userAreaEl = document.getElementById('user-area');
    const logoutBtn = document.getElementById('logout-btn');
    const historySectionEl = document.getElementById('history-section');
    const walletSectionEl = document.getElementById('wallet-section');
    const walletBalanceEl = document.getElementById('wallet-balance');
    const walletProductsEl = document.getElementById('wallet-products');
    const walletProductEmptyEl = document.getElementById('wallet-product-empty');
    const walletErrorEl = document.getElementById('wallet-error');
    const walletEntryEmptyEl = document.getElementById('wallet-entry-empty');
    const walletEntryTableWrapEl = document.getElementById('wallet-entry-table-wrap');
    const walletEntryTableBodyEl = document.getElementById('wallet-entry-table-body');
    const walletRefreshBtn = document.getElementById('wallet-refresh-btn');
    const walletPaymentLinkEl = document.getElementById('wallet-payment-link');
    const walletTopupQrEl = document.getElementById('wallet-topup-qr');

    const statsEl = document.getElementById('account-stats');
    const errorEl = document.getElementById('account-error');
    const emptyEl = document.getElementById('account-empty');
    const tableWrapEl = document.getElementById('account-table-wrap');
    const tableBodyEl = document.getElementById('account-table-body');
    const historyPaginationEl = document.getElementById('history-pagination');
    const historyPageStatusEl = document.getElementById('history-page-status');
    const historyPrevBtn = document.getElementById('history-prev-btn');
    const historyNextBtn = document.getElementById('history-next-btn');
    const historyFiltersEl = document.getElementById('history-filters');
    const historyQueryEl = document.getElementById('history-query');
    const historyFromEl = document.getElementById('history-from');
    const historyToEl = document.getElementById('history-to');
    const historyFavoriteEl = document.getElementById('history-favorite');
    const historyExportBtn = document.getElementById('history-export');
    const historyExportOptionsEl = document.getElementById('history-export-options');
    const historyExportDownloadBtn = document.getElementById('history-export-download');
    const historyExportSelectAllBtn = document.getElementById('history-export-select-all');
    const historyExportClearAllBtn = document.getElementById('history-export-clear-all');
    const HISTORY_PAGE_SIZE = 20;
    let historyPage = 1;
    let historyPageCount = 0;

    function escapeHtml(value) {
      return String(value)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function setStats(total, success, withLesson) {
      const failure = total - success;
      statsEl.innerHTML = `
        <div class="extension-stat">Trang này <strong>${total}</strong></div>
        <div class="extension-pill rounded-full px-3 py-1.5 text-sm font-bold">Bài học <strong>${withLesson}</strong></div>
        <div class="extension-stat">OK <strong>${success}</strong></div>
        <div class="extension-stat">Lỗi <strong>${failure}</strong></div>
      `;
    }

    function getLessonData(item) {
      const payload = item?.lesson;
      if (!payload || typeof payload !== 'object') return null;

      return {
        meaning: typeof payload.sentence_meaning_vi === 'string' ? payload.sentence_meaning_vi : null,
        notes: typeof payload.notes === 'string' ? payload.notes : null,
        vocabCount: Array.isArray(payload.vocabularies) ? payload.vocabularies.length : 0,
        grammarCount: Array.isArray(payload.grammar) ? payload.grammar.length : 0,
      };
    }

    function bindRowNavigation() {
      const rows = tableBodyEl.querySelectorAll('tr[data-href]');
      rows.forEach((row) => {
        const href = row.getAttribute('data-href');
        if (!href) return;

        row.addEventListener('click', (event) => {
          const target = event.target;
          if (target instanceof Element && target.closest('a, button, input, select, textarea, label')) return;
          window.location.href = href;
        });

        row.addEventListener('keydown', (event) => {
          if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            window.location.href = href;
          }
        });
      });
    }

    function renderUser(user, roles = []) {
      const name = escapeHtml(user.display_name || user.email);
      const email = escapeHtml(user.email || '');
      const avatar = user.avatar_url ? escapeHtml(user.avatar_url) : null;

      userAreaEl.innerHTML = `
        ${avatar
          ? `<img src="${avatar}" alt="Avatar" class="avatar size-10 rounded-full border border-base-300 object-cover" referrerpolicy="no-referrer" />`
          : `<div class="grid size-10 place-items-center rounded-full border border-base-300 bg-base-200 text-sm font-bold">${name.charAt(0).toUpperCase()}</div>`}
        <div>
          <p class="text-sm font-semibold">${name}</p>
          <p class="text-xs opacity-70">${email}</p>
          ${Array.isArray(roles) && roles.length ? '<a href="/admin" class="link link-primary mt-1 inline-block text-xs font-semibold">Mở Admin console</a>' : ''}
        </div>
      `;
    }

    function formatVnd(value) {
      return `${new Intl.NumberFormat('vi-VN').format(Number(value || 0))} VND`;
    }

    function formatDateTime(value) {
      if (typeof value !== 'string' || !value.trim()) return '-';
      const normalized = /^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}$/.test(value)
        ? `${value.replace(' ', 'T')}Z`
        : value;
      const date = new Date(normalized);
      if (Number.isNaN(date.getTime())) return value;
      return new Intl.DateTimeFormat('vi-VN', {
        dateStyle: 'short',
        timeStyle: 'short',
        timeZone: 'Asia/Ho_Chi_Minh',
      }).format(date);
    }

    function walletEntryLabel(entryType) {
      if (entryType === 'topup') return 'Nạp tiền';
      if (entryType === 'ai_charge') return 'Phí AI';
      return 'Điều chỉnh';
    }

    function showWalletError(message) {
      walletErrorEl.textContent = message;
      walletErrorEl.classList.remove('hidden');
    }

    function clearWalletError() {
      walletErrorEl.textContent = '';
      walletErrorEl.classList.add('hidden');
    }

    async function startCheckout(productCode, button) {
      clearWalletError();
      button.disabled = true;
      button.classList.add('opacity-60');
      try {
        const res = await fetch(checkoutUrl, {
          method: 'POST',
          credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ productCode }),
        });
        const data = await res.json();
        if (!res.ok || !data?.qrCode) {
          throw new Error(typeof data?.error === 'string' ? data.error : 'Không tạo được đơn thanh toán.');
        }
        walletPaymentLinkEl.href = data.qrCode;
        if (typeof data?.qrCode === 'string' && data.qrCode) {
          walletTopupQrEl.src = data.qrCode;
        }
        walletProductsEl.querySelectorAll('button[data-product-code]').forEach((productButton) => {
          const selected = productButton === button;
          productButton.classList.toggle('wallet-product-selected', selected);
          productButton.setAttribute('aria-pressed', String(selected));
        });
      } catch (err) {
        showWalletError(err instanceof Error ? err.message : 'Không tạo được đơn thanh toán.');
      } finally {
        button.disabled = false;
        button.classList.remove('opacity-60');
      }
    }

    function renderWallet(data) {
      walletBalanceEl.textContent = formatVnd(data?.balanceVnd);
      const products = Array.isArray(data?.products) ? data.products : [];
      walletProductsEl.innerHTML = products.map((product) => `
        <button type="button" aria-pressed="false" data-product-code="${escapeHtml(product.code)}" class="wallet-product-button">
          <span class="text-base font-bold">${formatVnd(product.amountVnd)}</span>
          <span class="text-xs opacity-70">Nạp vào ví</span>
        </button>
      `).join('');
      walletProductEmptyEl.classList.toggle('hidden', products.length > 0);
      walletProductsEl.querySelectorAll('button[data-product-code]').forEach((button) => {
        button.addEventListener('click', () => startCheckout(button.getAttribute('data-product-code'), button));
      });

      const entries = Array.isArray(data?.entries) ? data.entries : [];
      walletEntryEmptyEl.classList.toggle('hidden', entries.length > 0);
      walletEntryTableWrapEl.classList.toggle('hidden', entries.length === 0);
      walletEntryTableBodyEl.innerHTML = entries.map((entry) => {
        const amount = Number(entry.amountVnd || 0);
        const amountText = `${amount >= 0 ? '+' : ''}${formatVnd(amount)}`;
        return `<tr>
          <td class="whitespace-nowrap px-3 py-3 text-xs opacity-70">${escapeHtml(formatDateTime(entry.createdAt))}</td>
          <td class="px-3 py-3">${escapeHtml(walletEntryLabel(entry.entryType))}</td>
          <td class="whitespace-nowrap px-3 py-3 font-semibold ${amount >= 0 ? 'text-[#047857]' : 'text-[#be123c]'}">${amountText}</td>
          <td class="whitespace-nowrap px-3 py-3">${formatVnd(entry.balanceAfterVnd)}</td>
        </tr>`;
      }).join('');
    }

    async function loadWallet() {
      clearWalletError();
      try {
        const res = await fetch(walletUrl, { credentials: 'include' });
        const data = await res.json();
        if (!res.ok) throw new Error(typeof data?.error === 'string' ? data.error : 'Không tải được ví.');
        renderWallet(data);
      } catch (err) {
        showWalletError(err instanceof Error ? err.message : 'Không tải được ví.');
      }
    }

    async function requireAuth() {
      const res = await fetch(meUrl, { credentials: 'include' });
      if (!res.ok) {
        window.location.href = '/login';
        return null;
      }

      const data = await res.json();
      if (!data?.user) {
        window.location.href = '/login';
        return null;
      }

      return data;
    }

    function updateHistoryPagination(total) {
      const hasPages = total > 0;
      historyPaginationEl.classList.toggle('hidden', !hasPages);
      historyPaginationEl.classList.toggle('flex', hasPages);
      if (!hasPages) return;
      historyPageStatusEl.textContent = `Trang ${historyPage} / ${historyPageCount} (${total} phiên)`;
      historyPrevBtn.disabled = historyPage <= 1;
      historyNextBtn.disabled = historyPage >= historyPageCount;
    }

    async function loadHistory(page = historyPage) {
      historyPage = Math.max(1, Number(page) || 1);
      setStats(0, 0, 0);
      emptyEl.classList.add('hidden');
      tableWrapEl.classList.add('hidden');
      historyPaginationEl.classList.add('hidden');
      historyPaginationEl.classList.remove('flex');
      try {
        const url = new URL(historyUrl);
        url.searchParams.set('page', String(historyPage));
        url.searchParams.set('pageSize', String(HISTORY_PAGE_SIZE));
        const search = historyQueryEl?.value.trim();
        if (search) url.searchParams.set('q', search);
        if (historyFromEl?.value) url.searchParams.set('from', historyFromEl.value);
        if (historyToEl?.value) url.searchParams.set('to', historyToEl.value);
        if (historyFavoriteEl?.checked) url.searchParams.set('favorite', '1');
        const res = await fetch(url, { credentials: 'include' });
        const raw = await res.text();
        let data = null;
        try {
          data = raw ? JSON.parse(raw) : null;
        } catch {
          data = null;
        }

        if (!res.ok) {
          const textSnippet = raw ? raw.slice(0, 180) : '';
          const msg =
            data && typeof data.error === 'string'
              ? data.error
              : `${res.status} ${res.statusText}${textSnippet ? ` - ${textSnippet}` : ''}`;
          errorEl.textContent = `Không tải được lịch sử: ${msg}`;
          errorEl.classList.remove('hidden');
          return;
        }

        const items = data && Array.isArray(data.items) ? data.items : [];
        const total = Number(data?.total || 0);
        historyPageCount = Math.max(Number(data?.pageCount || 0), 0);
        if (historyPageCount > 0 && historyPage > historyPageCount) {
          return loadHistory(historyPageCount);
        }
        const successCount = items.filter((item) => item && item.success === true).length;
        const lessonCount = items.filter((item) => !!getLessonData(item)).length;
        setStats(items.length, successCount, lessonCount);
        updateHistoryPagination(total);

        if (items.length === 0) {
          emptyEl.classList.remove('hidden');
          return;
        }

        const rowsHtml = items
          .map((item) => {
            const lesson = getLessonData(item);
            const query = escapeHtml(item.query || '');
            const meaning = escapeHtml(lesson?.meaning || 'Chưa có bản dịch cho mục này.');
            const notes = escapeHtml(lesson?.notes || (item.error_message || 'Không có ghi chú.'));
            const vocabCount = Number(lesson?.vocabCount || 0);
            const grammarCount = Number(lesson?.grammarCount || 0);
            const createdAt = escapeHtml(formatDateTime(item.created_at));
            const detailHref = `/account/request?id=${Number(item.id || 0)}`;
            const sourceUrl = typeof item.source_url === 'string' ? item.source_url : '';
            const favorite = item.is_favorite === true;
            let sourceLink = '-';
            try {
              const source = new URL(sourceUrl);
              if (source.protocol === 'http:' || source.protocol === 'https:') {
                sourceLink = `<a class="text-xs font-semibold text-sky-700 hover:underline" href="${escapeHtml(sourceUrl)}" target="_blank" rel="noopener noreferrer">${escapeHtml(source.hostname)}</a>`;
              }
            } catch {
              // Old logs may not have a source URL.
            }

            return `
              <tr class="align-top cursor-pointer hover:bg-base-200 focus-within:bg-base-200" data-href="${detailHref}" tabindex="0">
                <td class="whitespace-nowrap px-3 py-3 text-xs opacity-70">${createdAt}</td>
                <td class="max-w-[300px] px-3 py-3">
                  <p class="line-clamp-2 break-words text-sm font-semibold" title="${query}">${query}</p>
                  <p class="mt-1 line-clamp-2 break-words text-xs opacity-70" title="${notes}">${notes}</p>
                </td>
                <td class="max-w-[300px] px-3 py-3">
                  <p class="line-clamp-3 break-words text-sm" title="${meaning}">${meaning}</p>
                </td>
                <td class="whitespace-nowrap px-3 py-3">
                  <div class="flex flex-wrap gap-2 text-xs">
                    <span class="extension-pill rounded-full px-2 py-1 text-xs font-bold">Từ vựng: ${vocabCount}</span>
                    <span class="extension-muted-pill rounded-full px-2 py-1 text-xs font-bold">Ngữ pháp: ${grammarCount}</span>
                  </div>
                </td>
                <td class="max-w-32 px-3 py-3 break-all">${sourceLink}</td>
                <td class="whitespace-nowrap px-3 py-3"><div class="flex gap-1"><button type="button" data-favorite-id="${Number(item.id || 0)}" data-favorite="${favorite ? '1' : '0'}" class="btn btn-outline btn-xs ${favorite ? 'btn-error' : ''}">${favorite ? 'Đã đánh dấu' : 'Đánh dấu'}</button><button type="button" data-delete-id="${Number(item.id || 0)}" class="btn btn-outline btn-xs">Xoá</button></div></td>
                <td class="whitespace-nowrap p-0">
                  <a class="btn btn-ghost btn-xs h-full w-full justify-start" href="${detailHref}">Mở bài học</a>
                </td>
              </tr>
            `;
          })
          .join('');

        tableBodyEl.innerHTML = rowsHtml;
        bindRowNavigation();
        tableBodyEl.querySelectorAll('button[data-favorite-id]').forEach((button) => button.addEventListener('click', async () => {
          const id = button.getAttribute('data-favorite-id');
          const favorite = button.getAttribute('data-favorite') !== '1';
          await fetch(`${historyUrl}/${id}/favorite`, { method: 'PATCH', credentials: 'include', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ favorite }) });
          loadHistory();
        }));
        tableBodyEl.querySelectorAll('button[data-delete-id]').forEach((button) => button.addEventListener('click', async () => {
          const id = button.getAttribute('data-delete-id');
          if (!window.confirm('Xoá mục lịch sử này?')) return;
          await fetch(`${historyUrl}/${id}`, { method: 'DELETE', credentials: 'include' });
          loadHistory();
        }));
        tableWrapEl.classList.remove('hidden');
      } catch (err) {
        const msg = err instanceof Error ? err.message : 'Failed to load history';
        errorEl.textContent = `Không tải được lịch sử: ${msg}`;
        errorEl.classList.remove('hidden');
      }
    }

    logoutBtn?.addEventListener('click', async () => {
      try {
        await fetch(logoutUrl, {
          method: 'POST',
          credentials: 'include',
        });
      } catch {
        // no-op
      }
      window.location.href = '/login';
    });

      walletRefreshBtn?.addEventListener('click', loadWallet);
    historyPrevBtn?.addEventListener('click', () => loadHistory(historyPage - 1));
    historyNextBtn?.addEventListener('click', () => loadHistory(historyPage + 1));
    historyFiltersEl?.addEventListener('submit', (event) => { event.preventDefault(); loadHistory(1); });
    function renderExportOptions() {
      if (!historyExportOptionsEl) return;
      historyExportOptionsEl.innerHTML = `
        <div class="mb-3 flex gap-2">
          <button id="history-export-select-all" type="button" class="btn btn-outline btn-xs">Chọn hết</button>
          <button id="history-export-clear-all" type="button" class="btn btn-outline btn-xs">Bỏ chọn hết</button>
        </div>
        <div class="grid gap-4 sm:grid-cols-3">
          <div>
            <p class="mb-2 font-semibold">Bài học</p>
            <div class="grid gap-2">
              <label class="label cursor-pointer justify-start gap-2"><input type="checkbox" class="checkbox checkbox-sm" name="csv-field" value="query" checked /> Nội dung</label>
              <label class="label cursor-pointer justify-start gap-2"><input type="checkbox" class="checkbox checkbox-sm" name="csv-field" value="sentence_hiragana" /> Hiragana</label>
              <label class="label cursor-pointer justify-start gap-2"><input type="checkbox" class="checkbox checkbox-sm" name="csv-field" value="meaning_vi" checked /> Nghĩa Việt</label>
              <label class="label cursor-pointer justify-start gap-2"><input type="checkbox" class="checkbox checkbox-sm" name="csv-field" value="notes" /> Ghi chú</label>
              <label class="label cursor-pointer justify-start gap-2"><input type="checkbox" class="checkbox checkbox-sm" name="csv-field" value="vocabularies" checked /> Từ vựng</label>
              <label class="label cursor-pointer justify-start gap-2"><input type="checkbox" class="checkbox checkbox-sm" name="csv-field" value="grammar" checked /> Ngữ pháp</label>
            </div>
          </div>
          <div>
            <p class="mb-2 font-semibold">Lịch sử</p>
            <div class="grid gap-2">
              <label class="label cursor-pointer justify-start gap-2"><input type="checkbox" class="checkbox checkbox-sm" name="csv-field" value="id" /> ID</label>
              <label class="label cursor-pointer justify-start gap-2"><input type="checkbox" class="checkbox checkbox-sm" name="csv-field" value="created_at" checked /> Thời gian</label>
              <label class="label cursor-pointer justify-start gap-2"><input type="checkbox" class="checkbox checkbox-sm" name="csv-field" value="source_url" checked /> URL nguồn</label>
              <label class="label cursor-pointer justify-start gap-2"><input type="checkbox" class="checkbox checkbox-sm" name="csv-field" value="favorite" /> Đã đánh dấu</label>
              <label class="label cursor-pointer justify-start gap-2"><input type="checkbox" class="checkbox checkbox-sm" name="csv-field" value="success" /> Thành công</label>
              <label class="label cursor-pointer justify-start gap-2"><input type="checkbox" class="checkbox checkbox-sm" name="csv-field" value="error_message" /> Lỗi</label>
            </div>
          </div>
          <div>
            <p class="mb-2 font-semibold">Kỹ thuật</p>
            <div class="grid gap-2">
              <label class="label cursor-pointer justify-start gap-2"><input type="checkbox" class="checkbox checkbox-sm" name="csv-field" value="model" /> Model</label>
              <label class="label cursor-pointer justify-start gap-2"><input type="checkbox" class="checkbox checkbox-sm" name="csv-field" value="duration_ms" /> Thời gian xử lý (ms)</label>
              <label class="label cursor-pointer justify-start gap-2"><input type="checkbox" class="checkbox checkbox-sm" name="csv-field" value="usage_total_tokens" /> Tổng tokens</label>
            </div>
          </div>
        </div>
        <button id="history-export-download" type="button" class="btn btn-success btn-sm mt-4">Tải CSV</button>
      `;
      document.getElementById('history-export-select-all')?.addEventListener('click', () => document.querySelectorAll('input[name="csv-field"]').forEach((field) => { field.checked = true; }));
      document.getElementById('history-export-clear-all')?.addEventListener('click', () => document.querySelectorAll('input[name="csv-field"]').forEach((field) => { field.checked = false; }));
      document.getElementById('history-export-download')?.addEventListener('click', () => {
        const url = new URL(`${historyUrl}/export.csv`);
        if (historyQueryEl?.value.trim()) url.searchParams.set('q', historyQueryEl.value.trim());
        if (historyFromEl?.value) url.searchParams.set('from', historyFromEl.value);
        if (historyToEl?.value) url.searchParams.set('to', historyToEl.value);
        if (historyFavoriteEl?.checked) url.searchParams.set('favorite', '1');
        const fields = [...document.querySelectorAll('input[name="csv-field"]:checked')].map((field) => field.value);
        if (!fields.length) { window.alert('Chọn ít nhất một cột để export.'); return; }
        url.searchParams.set('fields', fields.join(','));
        window.location.href = url.toString();
      });
    }
    renderExportOptions();
    historyExportBtn?.addEventListener('click', () => historyExportOptionsEl?.classList.toggle('hidden'));
    historyExportDownloadBtn?.addEventListener('click', () => {
      const url = new URL(`${historyUrl}/export.csv`);
      if (historyQueryEl?.value.trim()) url.searchParams.set('q', historyQueryEl.value.trim());
      if (historyFromEl?.value) url.searchParams.set('from', historyFromEl.value);
      if (historyToEl?.value) url.searchParams.set('to', historyToEl.value);
      if (historyFavoriteEl?.checked) url.searchParams.set('favorite', '1');
      const fields = [...document.querySelectorAll('input[name="csv-field"]:checked')].map((field) => field.value);
      if (!fields.length) { window.alert('Chọn ít nhất một cột để export.'); return; }
      url.searchParams.set('fields', fields.join(','));
      window.location.href = url.toString();
    });

    const accountTabs = new Set(['learning', 'wallet']);
    function activateAccountTab(name, updateUrl = false) {
      const tabName = accountTabs.has(name) ? name : 'learning';
      document.querySelectorAll('[data-tab]').forEach((tab) => {
        const active = tab.getAttribute('data-tab') === tabName;
        tab.classList.toggle('tab-active', active);
      });
      document.querySelectorAll('[data-panel]').forEach((panel) => {
        panel.classList.toggle('hidden', panel.getAttribute('data-panel') !== tabName);
      });
      if (updateUrl) {
        const url = new URL(window.location.href);
        url.searchParams.set('tab', tabName);
        window.history.pushState({}, '', url);
      }
    }

    document.querySelectorAll('[data-tab]').forEach((tab) => {
      tab.addEventListener('click', () => activateAccountTab(tab.getAttribute('data-tab'), true));
    });
    window.addEventListener('popstate', () => activateAccountTab(new URLSearchParams(window.location.search).get('tab') || 'learning'));

    (async () => {
      const auth = await requireAuth();
      if (!auth) return;
      const user = auth.user;

      renderUser(user, auth.roles);
      logoutBtn?.classList.remove('hidden');
      walletSectionEl?.classList.remove('hidden');
      historySectionEl?.classList.remove('hidden');
      await Promise.all([loadWallet(), loadHistory()]);
      activateAccountTab(new URLSearchParams(window.location.search).get('tab') || 'learning');
    })();
  </script>
</Layout>
