---
import Layout from '../layouts/Layout.astro';

const apiBase = import.meta.env.PUBLIC_API_BASE_URL?.replace(/\/$/, '') ?? 'http://localhost:8787';
const historyUrl = `${apiBase}/history`;
const meUrl = `${apiBase}/auth/me`;
const logoutUrl = `${apiBase}/auth/logout`;
const walletUrl = `${apiBase}/billing/wallet`;
const checkoutUrl = `${apiBase}/billing/checkout`;
---

<Layout>
  <main
    class="min-h-screen bg-slate-50 px-6 py-12 text-slate-800"
    data-history-url={historyUrl}
    data-me-url={meUrl}
    data-logout-url={logoutUrl}
    data-wallet-url={walletUrl}
    data-checkout-url={checkoutUrl}
  >
    <div class="mx-auto w-full max-w-6xl">
      <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
        <a href="/" class="inline-flex text-sm text-slate-600 hover:text-slate-900">← Về trang chủ</a>
      </div>

      <section class="mb-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <div class="flex flex-wrap items-center justify-between gap-4">
          <div id="user-area" class="flex items-center gap-3">
            <div class="size-10 animate-pulse rounded-full bg-slate-200"></div>
            <div>
              <p class="h-4 w-36 animate-pulse rounded bg-slate-200"></p>
              <p class="mt-2 h-3 w-52 animate-pulse rounded bg-slate-100"></p>
            </div>
          </div>
          <button
            id="logout-btn"
            type="button"
            class="hidden rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-700 transition-colors hover:bg-slate-100"
          >
            Logout
          </button>
        </div>
      </section>

      <section id="wallet-section" class="mb-6 hidden rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <div class="flex flex-wrap items-start justify-between gap-4">
          <div>
            <h1 class="text-2xl font-bold tracking-[-0.02em]">Ví AI</h1>
            <p class="mt-1.5 text-sm text-slate-600">Nạp số dư để dùng phần giải thích AI trong extension.</p>
          </div>
          <button id="wallet-refresh-btn" type="button" class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-100">Tải lại số dư</button>
        </div>

        <div class="mt-5 grid gap-5 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)]">
          <div class="border-l-4 border-emerald-500 bg-emerald-50 px-4 py-4">
            <p class="text-sm text-emerald-800">Số dư hiện tại</p>
            <p id="wallet-balance" class="mt-1 text-3xl font-bold text-emerald-950">...</p>
            <p class="mt-2 text-xs text-emerald-800">Phí AI được trừ sau mỗi lần phân tích thành công.</p>
          </div>
          <div>
            <h2 class="text-sm font-semibold uppercase tracking-[0.08em] text-slate-700">Nạp tiền</h2>
            <div id="wallet-products" class="mt-3 grid gap-2 sm:grid-cols-3"></div>
            <p id="wallet-product-empty" class="hidden mt-3 text-sm text-slate-500">Chưa có gói nạp khả dụng.</p>
            <div class="mt-4 flex flex-wrap items-center gap-4 border border-amber-200 bg-amber-50 p-3">
              <img
                id="wallet-topup-qr"
                src="https://vietqr.app/img?bank=BIDV&amp;acc=96247OW8RC&amp;template=compact&amp;holder=DANG%20THAI%20AN"
                alt="QR chuyển khoản BIDV tới DANG THAI AN"
                width="132"
                height="132"
                class="border border-amber-200 bg-white"
              />
              <div class="min-w-0 flex-1 text-sm text-amber-950">
                <p class="font-semibold">Chuyển khoản thủ công (tạm thời)</p>
                <p id="wallet-topup-qr-note" class="mt-1 text-xs leading-relaxed text-amber-900">Đang tải QR nạp tiền...</p>
              </div>
            </div>
          </div>
        </div>

        <div id="wallet-payment" class="hidden mt-5 border border-sky-200 bg-sky-50 p-4 text-sm text-sky-950">
          <p class="font-semibold">Đơn thanh toán đã được tạo.</p>
          <p class="mt-1 text-sky-800">Quét QR SePay vừa tạo và giữ nguyên nội dung chuyển khoản. Số dư sẽ được cộng sau khi SePay xác nhận giao dịch.</p>
          <div class="mt-3 flex flex-wrap gap-2">
            <a id="wallet-payment-link" class="inline-flex items-center justify-center rounded-lg bg-sky-700 px-3 py-2 font-semibold text-white hover:bg-sky-800" target="_blank" rel="noopener noreferrer">Mở QR nạp tiền</a>
            <button id="wallet-payment-refresh" type="button" class="rounded-lg border border-sky-300 bg-white px-3 py-2 font-semibold text-sky-800 hover:bg-sky-100">Tải lại sau khi thanh toán</button>
          </div>
        </div>

        <div id="wallet-error" class="hidden mt-5 border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700"></div>

        <div class="mt-6">
          <h2 class="text-sm font-semibold uppercase tracking-[0.08em] text-slate-700">Lịch sử giao dịch</h2>
          <div id="wallet-entry-empty" class="hidden mt-3 border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-600">Chưa có giao dịch nào.</div>
          <div id="wallet-entry-table-wrap" class="hidden mt-3 overflow-x-auto border border-slate-200">
            <table class="min-w-full divide-y divide-slate-200 text-sm">
              <thead class="bg-slate-100 text-left text-xs uppercase tracking-[0.08em] text-slate-600">
                <tr><th class="px-3 py-2">Thời gian</th><th class="px-3 py-2">Loại</th><th class="px-3 py-2">Thay đổi</th><th class="px-3 py-2">Số dư sau giao dịch</th></tr>
              </thead>
              <tbody id="wallet-entry-table-body" class="divide-y divide-slate-100 bg-white"></tbody>
            </table>
          </div>
        </div>
      </section>

      <section id="history-section" class="hidden rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <div class="mb-5 flex flex-wrap items-start justify-between gap-3">
          <div>
            <h1 class="text-2xl font-bold tracking-[-0.02em]">Learning History</h1>
            <p class="mt-1.5 text-sm text-slate-600">Xem nhanh các đoạn tiếng Nhật bạn đã học và mở lại từng bài chi tiết.</p>
          </div>
          <div id="account-stats" class="grid gap-2 text-sm text-slate-700"></div>
        </div>

        <div
          id="account-error"
          class="hidden rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700"
        ></div>

        <div
          id="account-empty"
          class="hidden rounded-lg border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-600"
        >
          Chưa có lịch sử nào.
        </div>

        <div id="account-table-wrap" class="hidden overflow-x-auto rounded-xl border border-slate-200">
          <table class="min-w-full divide-y divide-slate-200 text-sm">
            <thead class="bg-slate-100 text-left text-xs uppercase tracking-[0.08em] text-slate-600">
              <tr>
                <th class="px-3 py-2">Thời gian</th>
                <th class="px-3 py-2">Nội dung</th>
                <th class="px-3 py-2">Nghĩa</th>
                <th class="px-3 py-2">Trọng tâm</th>
                <th class="px-3 py-2">Bài học</th>
              </tr>
            </thead>
            <tbody id="account-table-body" class="divide-y divide-slate-100 bg-white"></tbody>
          </table>
        </div>
        <nav id="history-pagination" class="mt-4 hidden items-center justify-between gap-3" aria-label="Phân trang lịch sử học">
          <p id="history-page-status" class="text-sm text-slate-600"></p>
          <div class="flex items-center gap-2">
            <button id="history-prev-btn" type="button" class="border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-100 disabled:cursor-not-allowed disabled:opacity-50">Trang trước</button>
            <button id="history-next-btn" type="button" class="border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-100 disabled:cursor-not-allowed disabled:opacity-50">Trang sau</button>
          </div>
        </nav>
      </section>
    </div>
  </main>
  <script is:inline>
    const mainEl = document.querySelector('main[data-history-url]');
    const historyUrl = mainEl ? mainEl.getAttribute('data-history-url') : '';
    const meUrl = mainEl ? mainEl.getAttribute('data-me-url') : '';
    const logoutUrl = mainEl ? mainEl.getAttribute('data-logout-url') : '';
    const walletUrl = mainEl ? mainEl.getAttribute('data-wallet-url') : '';
    const checkoutUrl = mainEl ? mainEl.getAttribute('data-checkout-url') : '';

    const userAreaEl = document.getElementById('user-area');
    const logoutBtn = document.getElementById('logout-btn');
    const historySectionEl = document.getElementById('history-section');
    const walletSectionEl = document.getElementById('wallet-section');
    const walletBalanceEl = document.getElementById('wallet-balance');
    const walletProductsEl = document.getElementById('wallet-products');
    const walletProductEmptyEl = document.getElementById('wallet-product-empty');
    const walletErrorEl = document.getElementById('wallet-error');
    const walletEntryEmptyEl = document.getElementById('wallet-entry-empty');
    const walletEntryTableWrapEl = document.getElementById('wallet-entry-table-wrap');
    const walletEntryTableBodyEl = document.getElementById('wallet-entry-table-body');
    const walletRefreshBtn = document.getElementById('wallet-refresh-btn');
    const walletPaymentEl = document.getElementById('wallet-payment');
    const walletPaymentLinkEl = document.getElementById('wallet-payment-link');
    const walletPaymentRefreshBtn = document.getElementById('wallet-payment-refresh');
    const walletTopupQrEl = document.getElementById('wallet-topup-qr');
    const walletTopupQrNoteEl = document.getElementById('wallet-topup-qr-note');

    const statsEl = document.getElementById('account-stats');
    const errorEl = document.getElementById('account-error');
    const emptyEl = document.getElementById('account-empty');
    const tableWrapEl = document.getElementById('account-table-wrap');
    const tableBodyEl = document.getElementById('account-table-body');
    const historyPaginationEl = document.getElementById('history-pagination');
    const historyPageStatusEl = document.getElementById('history-page-status');
    const historyPrevBtn = document.getElementById('history-prev-btn');
    const historyNextBtn = document.getElementById('history-next-btn');
    const HISTORY_PAGE_SIZE = 20;
    let historyPage = 1;
    let historyPageCount = 0;

    function escapeHtml(value) {
      return String(value)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function setStats(total, success, withLesson) {
      const failure = total - success;
      statsEl.innerHTML = `
        <div class="rounded-lg border border-slate-200 bg-slate-50 px-3 py-2">Trang này: <strong>${total}</strong></div>
        <div class="rounded-lg border border-sky-200 bg-sky-50 px-3 py-2">Có nội dung bài học: <strong>${withLesson}</strong></div>
        <div class="rounded-lg border border-emerald-200 bg-emerald-50 px-3 py-2">Thành công: <strong>${success}</strong></div>
        <div class="rounded-lg border border-rose-200 bg-rose-50 px-3 py-2">Cần thử lại: <strong>${failure}</strong></div>
      `;
    }

    function getLessonData(item) {
      const payload = item?.lesson;
      if (!payload || typeof payload !== 'object') return null;

      return {
        meaning: typeof payload.sentence_meaning_vi === 'string' ? payload.sentence_meaning_vi : null,
        notes: typeof payload.notes === 'string' ? payload.notes : null,
        vocabCount: Array.isArray(payload.vocabularies) ? payload.vocabularies.length : 0,
        grammarCount: Array.isArray(payload.grammar) ? payload.grammar.length : 0,
      };
    }

    function bindRowNavigation() {
      const rows = tableBodyEl.querySelectorAll('tr[data-href]');
      rows.forEach((row) => {
        const href = row.getAttribute('data-href');
        if (!href) return;

        row.addEventListener('click', (event) => {
          const target = event.target;
          if (target instanceof Element && target.closest('a, button, input, select, textarea, label')) return;
          window.location.href = href;
        });

        row.addEventListener('keydown', (event) => {
          if (event.key === 'Enter' || event.key === ' ') {
            event.preventDefault();
            window.location.href = href;
          }
        });
      });
    }

    function renderUser(user) {
      const name = escapeHtml(user.display_name || user.email);
      const email = escapeHtml(user.email || '');
      const avatar = user.avatar_url ? escapeHtml(user.avatar_url) : null;

      userAreaEl.innerHTML = `
        ${avatar
          ? `<img src="${avatar}" alt="Avatar" class="size-10 rounded-full border border-slate-200 object-cover" referrerpolicy="no-referrer" />`
          : `<div class="grid size-10 place-items-center rounded-full border border-slate-200 bg-slate-100 text-sm font-bold text-slate-700">${name.charAt(0).toUpperCase()}</div>`}
        <div>
          <p class="text-sm font-semibold text-slate-900">${name}</p>
          <p class="text-xs text-slate-500">${email}</p>
        </div>
      `;
    }

    function formatVnd(value) {
      return `${new Intl.NumberFormat('vi-VN').format(Number(value || 0))} VND`;
    }

    function formatDateTime(value) {
      if (typeof value !== 'string' || !value.trim()) return '-';
      const normalized = /^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}$/.test(value)
        ? `${value.replace(' ', 'T')}Z`
        : value;
      const date = new Date(normalized);
      if (Number.isNaN(date.getTime())) return value;
      return new Intl.DateTimeFormat('vi-VN', {
        dateStyle: 'short',
        timeStyle: 'short',
        timeZone: 'Asia/Ho_Chi_Minh',
      }).format(date);
    }

    function walletEntryLabel(entryType) {
      if (entryType === 'topup') return 'Nạp tiền';
      if (entryType === 'ai_charge') return 'Phí AI';
      return 'Điều chỉnh';
    }

    function showWalletError(message) {
      walletErrorEl.textContent = message;
      walletErrorEl.classList.remove('hidden');
    }

    function clearWalletError() {
      walletErrorEl.textContent = '';
      walletErrorEl.classList.add('hidden');
    }

    async function startCheckout(productCode, button) {
      clearWalletError();
      button.disabled = true;
      button.classList.add('opacity-60');
      try {
        const res = await fetch(checkoutUrl, {
          method: 'POST',
          credentials: 'include',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ productCode }),
        });
        const data = await res.json();
        if (!res.ok || !data?.paymentLink) {
          throw new Error(typeof data?.error === 'string' ? data.error : 'Không tạo được đơn thanh toán.');
        }
        walletPaymentLinkEl.href = data.paymentLink;
        if (typeof data?.qrCode === 'string' && data.qrCode) {
          walletTopupQrEl.src = data.qrCode;
        }
        if (typeof data?.transferContent === 'string' && data.transferContent) {
          walletTopupQrNoteEl.textContent = `Quét QR và giữ nguyên nội dung ${data.transferContent} để số dư được cộng tự động.`;
        }
        walletPaymentEl.classList.remove('hidden');
      } catch (err) {
        showWalletError(err instanceof Error ? err.message : 'Không tạo được đơn thanh toán.');
      } finally {
        button.disabled = false;
        button.classList.remove('opacity-60');
      }
    }

    function renderWallet(data) {
      walletBalanceEl.textContent = formatVnd(data?.balanceVnd);
      if (typeof data?.topupQrCode === 'string' && data.topupQrCode) {
        walletTopupQrEl.src = data.topupQrCode;
      }
      walletTopupQrNoteEl.textContent = data?.transferContent
        ? `Quét QR và giữ nguyên nội dung ${data.transferContent} để số dư được cộng tự động.`
        : 'Không tải được thông tin QR nạp tiền.';
      const products = Array.isArray(data?.products) ? data.products : [];
      walletProductsEl.innerHTML = products.map((product) => `
        <button type="button" data-product-code="${escapeHtml(product.code)}" class="border border-slate-200 bg-white px-3 py-3 text-left hover:border-emerald-400 hover:bg-emerald-50">
          <span class="block text-sm font-semibold text-slate-900">${formatVnd(product.amountVnd)}</span>
          <span class="mt-1 block text-xs text-slate-600">Nạp vào ví</span>
        </button>
      `).join('');
      walletProductEmptyEl.classList.toggle('hidden', products.length > 0);
      walletProductsEl.querySelectorAll('button[data-product-code]').forEach((button) => {
        button.addEventListener('click', () => startCheckout(button.getAttribute('data-product-code'), button));
      });

      const entries = Array.isArray(data?.entries) ? data.entries : [];
      walletEntryEmptyEl.classList.toggle('hidden', entries.length > 0);
      walletEntryTableWrapEl.classList.toggle('hidden', entries.length === 0);
      walletEntryTableBodyEl.innerHTML = entries.map((entry) => {
        const amount = Number(entry.amountVnd || 0);
        const amountClass = amount >= 0 ? 'text-emerald-700' : 'text-rose-700';
        const amountText = `${amount >= 0 ? '+' : ''}${formatVnd(amount)}`;
        return `<tr>
          <td class="whitespace-nowrap px-3 py-3 text-xs text-slate-500">${escapeHtml(formatDateTime(entry.createdAt))}</td>
          <td class="px-3 py-3 text-slate-700">${escapeHtml(walletEntryLabel(entry.entryType))}</td>
          <td class="whitespace-nowrap px-3 py-3 font-semibold ${amountClass}">${amountText}</td>
          <td class="whitespace-nowrap px-3 py-3 text-slate-700">${formatVnd(entry.balanceAfterVnd)}</td>
        </tr>`;
      }).join('');
    }

    async function loadWallet() {
      clearWalletError();
      try {
        const res = await fetch(walletUrl, { credentials: 'include' });
        const data = await res.json();
        if (!res.ok) throw new Error(typeof data?.error === 'string' ? data.error : 'Không tải được ví.');
        renderWallet(data);
      } catch (err) {
        showWalletError(err instanceof Error ? err.message : 'Không tải được ví.');
      }
    }

    async function requireAuth() {
      const res = await fetch(meUrl, { credentials: 'include' });
      if (!res.ok) {
        window.location.href = '/login';
        return null;
      }

      const data = await res.json();
      if (!data?.user) {
        window.location.href = '/login';
        return null;
      }

      return data.user;
    }

    function updateHistoryPagination(total) {
      const hasPages = total > 0;
      historyPaginationEl.classList.toggle('hidden', !hasPages);
      historyPaginationEl.classList.toggle('flex', hasPages);
      if (!hasPages) return;
      historyPageStatusEl.textContent = `Trang ${historyPage} / ${historyPageCount} (${total} phiên)`;
      historyPrevBtn.disabled = historyPage <= 1;
      historyNextBtn.disabled = historyPage >= historyPageCount;
    }

    async function loadHistory(page = historyPage) {
      historyPage = Math.max(1, Number(page) || 1);
      setStats(0, 0, 0);
      emptyEl.classList.add('hidden');
      tableWrapEl.classList.add('hidden');
      historyPaginationEl.classList.add('hidden');
      historyPaginationEl.classList.remove('flex');
      try {
        const url = new URL(historyUrl);
        url.searchParams.set('page', String(historyPage));
        url.searchParams.set('pageSize', String(HISTORY_PAGE_SIZE));
        const res = await fetch(url, { credentials: 'include' });
        const raw = await res.text();
        let data = null;
        try {
          data = raw ? JSON.parse(raw) : null;
        } catch {
          data = null;
        }

        if (!res.ok) {
          const textSnippet = raw ? raw.slice(0, 180) : '';
          const msg =
            data && typeof data.error === 'string'
              ? data.error
              : `${res.status} ${res.statusText}${textSnippet ? ` - ${textSnippet}` : ''}`;
          errorEl.textContent = `Không tải được lịch sử: ${msg}`;
          errorEl.classList.remove('hidden');
          return;
        }

        const items = data && Array.isArray(data.items) ? data.items : [];
        const total = Number(data?.total || 0);
        historyPageCount = Math.max(Number(data?.pageCount || 0), 0);
        if (historyPageCount > 0 && historyPage > historyPageCount) {
          return loadHistory(historyPageCount);
        }
        const successCount = items.filter((item) => item && item.success === true).length;
        const lessonCount = items.filter((item) => !!getLessonData(item)).length;
        setStats(items.length, successCount, lessonCount);
        updateHistoryPagination(total);

        if (items.length === 0) {
          emptyEl.classList.remove('hidden');
          return;
        }

        const rowsHtml = items
          .map((item) => {
            const lesson = getLessonData(item);
            const query = escapeHtml(item.query || '');
            const meaning = escapeHtml(lesson?.meaning || 'Chưa có bản dịch cho mục này.');
            const notes = escapeHtml(lesson?.notes || (item.error_message || 'Không có ghi chú.'));
            const vocabCount = Number(lesson?.vocabCount || 0);
            const grammarCount = Number(lesson?.grammarCount || 0);
            const createdAt = escapeHtml(formatDateTime(item.created_at));
            const detailHref = `/account/request?id=${Number(item.id || 0)}`;

            return `
              <tr class="align-top cursor-pointer hover:bg-slate-50 focus-within:bg-slate-50" data-href="${detailHref}" tabindex="0">
                <td class="whitespace-nowrap px-3 py-3 text-xs text-slate-500">${createdAt}</td>
                <td class="max-w-[300px] px-3 py-3">
                  <p class="line-clamp-2 break-words text-sm font-semibold text-slate-900" title="${query}">${query}</p>
                  <p class="mt-1 line-clamp-2 break-words text-xs text-slate-500" title="${notes}">${notes}</p>
                </td>
                <td class="max-w-[300px] px-3 py-3">
                  <p class="line-clamp-3 break-words text-sm text-slate-700" title="${meaning}">${meaning}</p>
                </td>
                <td class="whitespace-nowrap px-3 py-3">
                  <div class="flex flex-wrap gap-2 text-xs">
                    <span class="rounded-full border border-sky-200 bg-sky-50 px-2 py-1 text-sky-700">Từ vựng: ${vocabCount}</span>
                    <span class="rounded-full border border-amber-200 bg-amber-50 px-2 py-1 text-amber-700">Ngữ pháp: ${grammarCount}</span>
                  </div>
                </td>
                <td class="whitespace-nowrap p-0">
                  <a class="block h-full w-full px-3 py-3 text-xs font-semibold text-slate-800 hover:bg-slate-100 focus-visible:bg-slate-100 focus-visible:outline-none" href="${detailHref}">Mở bài học</a>
                </td>
              </tr>
            `;
          })
          .join('');

        tableBodyEl.innerHTML = rowsHtml;
        bindRowNavigation();
        tableWrapEl.classList.remove('hidden');
      } catch (err) {
        const msg = err instanceof Error ? err.message : 'Failed to load history';
        errorEl.textContent = `Không tải được lịch sử: ${msg}`;
        errorEl.classList.remove('hidden');
      }
    }

    logoutBtn?.addEventListener('click', async () => {
      try {
        await fetch(logoutUrl, {
          method: 'POST',
          credentials: 'include',
        });
      } catch {
        // no-op
      }
      window.location.href = '/login';
    });

    walletRefreshBtn?.addEventListener('click', loadWallet);
    walletPaymentRefreshBtn?.addEventListener('click', loadWallet);
    historyPrevBtn?.addEventListener('click', () => loadHistory(historyPage - 1));
    historyNextBtn?.addEventListener('click', () => loadHistory(historyPage + 1));

    (async () => {
      const user = await requireAuth();
      if (!user) return;

      renderUser(user);
      logoutBtn?.classList.remove('hidden');
      walletSectionEl?.classList.remove('hidden');
      historySectionEl?.classList.remove('hidden');
      await Promise.all([loadWallet(), loadHistory()]);
    })();
  </script>
</Layout>
