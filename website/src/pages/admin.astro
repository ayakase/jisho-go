---
import Layout from '../layouts/Layout.astro';
const apiBase = import.meta.env.PUBLIC_API_BASE_URL?.replace(/\/$/, '') ?? 'http://localhost:8787';
---
<Layout>
  <main class="min-h-screen bg-slate-50 px-4 py-8 text-slate-800 sm:px-6" data-api-base={apiBase}>
    <div class="mx-auto max-w-7xl">
      <header class="mb-6 flex flex-wrap items-end justify-between gap-3">
        <div><a href="/account" class="text-sm text-slate-500 hover:text-slate-900">← Tài khoản</a><h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-950">Quản trị Jisho Go</h1><p class="mt-1 text-sm text-slate-500">Theo dõi vận hành, ví và cấu hình ứng dụng.</p></div>
        <button id="logout" class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-semibold hover:bg-slate-100">Đăng xuất</button>
      </header>
      <nav class="mb-6 flex gap-1 overflow-x-auto border-b border-slate-200" aria-label="Các khu vực quản trị"><button data-tab="dashboard" class="tab-btn border-b-2 border-sky-600 px-3 py-3 text-sm font-semibold text-sky-700">Tổng quan</button><button data-tab="operations" class="tab-btn border-b-2 border-transparent px-3 py-3 text-sm font-semibold text-slate-500 hover:text-slate-900">Vận hành</button><button data-tab="settings" class="tab-btn border-b-2 border-transparent px-3 py-3 text-sm font-semibold text-slate-500 hover:text-slate-900">Cấu hình</button></nav>
      <div id="error" class="mb-4 hidden border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700"></div>
      <div id="toast" class="pointer-events-none fixed right-5 top-5 z-50 hidden rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-semibold text-emerald-800 shadow-lg" role="status"></div>
      <section id="overview" class="mb-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-4"></section>
      <div data-panel="dashboard" class="grid gap-6">
        <section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
          <div class="flex flex-wrap items-center justify-between gap-3"><h2 class="text-lg font-bold">Người dùng & ví</h2><input id="user-search" class="border border-slate-300 px-3 py-2 text-sm" placeholder="Tìm email / tên" /></div>
          <div class="mt-4 overflow-x-auto"><table class="min-w-full text-sm"><thead class="bg-slate-100 text-left text-xs uppercase text-slate-600"><tr><th class="p-2">ID</th><th class="p-2">Người dùng</th><th class="p-2">Vai trò</th><th class="p-2">Đã cộng ví</th><th class="p-2">Đã dùng AI</th><th class="p-2">Số dư</th><th class="p-2">Điều chỉnh</th></tr></thead><tbody id="users" class="divide-y divide-slate-100"></tbody></table></div>
        </section>
      </div>
      <div data-panel="operations" class="hidden grid gap-6 lg:grid-cols-2">
        <section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm"><h2 class="text-lg font-bold">AI request logs</h2><p class="mt-1 text-xs text-slate-500">Chi phí provider chỉ hiển thị trong khu vực nội bộ này.</p><div class="mt-4 overflow-x-auto"><table class="min-w-full text-xs"><thead class="bg-slate-100 text-left"><tr><th class="p-2">Thời gian</th><th class="p-2">User</th><th class="p-2">Model</th><th class="p-2">Tokens</th><th class="p-2">Cost USD</th><th class="p-2">Kết quả</th></tr></thead><tbody id="logs" class="divide-y divide-slate-100"></tbody></table></div></section>
        <section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm"><h2 class="text-lg font-bold">Giao dịch SePay</h2><div class="mt-4 overflow-x-auto"><table class="min-w-full text-xs"><thead class="bg-slate-100 text-left"><tr><th class="p-2">Thời gian</th><th class="p-2">Reference</th><th class="p-2">User</th><th class="p-2">Số tiền</th><th class="p-2">Ledger</th></tr></thead><tbody id="payments" class="divide-y divide-slate-100"></tbody></table></div></section>
        <section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm lg:col-span-2"><h2 class="text-lg font-bold">Audit log</h2><div class="mt-4 overflow-x-auto"><table class="min-w-full text-xs"><thead class="bg-slate-100 text-left"><tr><th class="p-2">Thời gian</th><th class="p-2">Actor</th><th class="p-2">Action</th><th class="p-2">Target</th><th class="p-2">Chi tiết</th></tr></thead><tbody id="audit" class="divide-y divide-slate-100"></tbody></table></div></section>
      </div>
      <div data-panel="settings" class="hidden"><section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm"><h2 class="text-lg font-bold">Cấu hình ứng dụng</h2><p class="mt-1 text-sm text-slate-500">Thay đổi có hiệu lực trong tối đa 60 giây. API key và secret không nằm ở đây.</p><div id="config" class="mt-5 grid gap-5 md:grid-cols-2"></div><div class="mt-6 border-t border-slate-200 pt-5"><h3 class="text-lg font-bold">Gói nạp tiền</h3><form id="product-form" class="mt-3 flex flex-wrap gap-2"><input name="code" class="border border-slate-300 px-3 py-2 text-sm" placeholder="topup_200k" required><input name="amountVnd" type="number" min="1000" class="w-36 border border-slate-300 px-3 py-2 text-sm" placeholder="Số tiền VND" required><label class="inline-flex items-center gap-2 px-2 text-sm"><input name="active" type="checkbox" checked> Active</label><button class="rounded-md bg-rose-400 px-3 py-2 text-sm font-semibold text-white">Thêm / lưu gói</button></form><div id="products-admin" class="mt-4 grid gap-2 sm:grid-cols-2 lg:grid-cols-3"></div></div></section>
      </div>
    </div>
  </main>
  <script is:inline>
    const root = document.querySelector('main[data-api-base]'); const api = root?.dataset.apiBase || ''; const $ = (id) => document.getElementById(id);
    const esc = (v) => String(v ?? '').replace(/[&<>"']/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    const vnd = (v) => `${new Intl.NumberFormat('vi-VN').format(Number(v || 0))} VND`;
    const dt = (v) => { const d = new Date(String(v || '').includes(' ') ? `${v.replace(' ','T')}Z` : v); return Number.isNaN(d.getTime()) ? esc(v) : new Intl.DateTimeFormat('vi-VN',{dateStyle:'short',timeStyle:'short',timeZone:'Asia/Ho_Chi_Minh'}).format(d); };
    async function get(path) { const r = await fetch(`${api}${path}`, { credentials:'include' }); const d = await r.json().catch(()=>({})); if (!r.ok) throw new Error(d.error || `${r.status}`); return d; }
    async function load() {
      try {
        const me = await get('/admin/me');
        const roles = me.roles || [];
        const search = encodeURIComponent($('user-search')?.value || '');
        const [overview, users, logs, payments, config, audit, products] = await Promise.all([get('/admin/overview'), get(`/admin/users?limit=100&search=${search}`), get('/admin/logs?limit=50'), get('/admin/sepay-transactions?limit=50'), get('/admin/config'), get('/admin/audit-logs?limit=50'), get('/admin/payment-products')]);
        $('overview').innerHTML = [['Users',overview.users],['Đã cộng ví',vnd(overview.walletTopupVnd)],['Đã dùng AI',vnd(overview.walletAiSpentVnd)],['Ví đang lưu',vnd(overview.walletBalanceVnd)]].map(([k,val])=>`<div class="border border-slate-200 bg-white p-4 shadow-sm"><p class="text-xs uppercase text-slate-500">${k}</p><p class="mt-1 text-2xl font-bold text-slate-950">${esc(val)}</p></div>`).join('');
        const canWallet = roles.includes('owner') || roles.includes('admin');
        const canRoles = roles.includes('owner');
        $('users').innerHTML = (users.items||[]).map(u=>`<tr><td class="p-2">${u.id}</td><td class="p-2"><div class="font-semibold">${esc(u.display_name || '-')}</div><div class="text-xs text-slate-500">${esc(u.email)}</div></td><td class="p-2">${canRoles?`<form data-role-user="${u.id}" class="space-y-2"><div class="flex flex-wrap gap-x-3 gap-y-1 text-xs">${['owner','admin','support','viewer'].map(role=>`<label class="inline-flex items-center gap-1"><input type="checkbox" name="role" value="${role}" ${(u.roles||[]).includes(role)?'checked':''}>${role}</label>`).join('')}</div><button class="rounded-md border border-rose-300 px-2 py-1 text-xs font-semibold text-rose-700 hover:bg-rose-50">Lưu quyền</button></form>`:esc((u.roles||[]).join(', ')||'-')}</td><td class="p-2 font-semibold text-emerald-700">${vnd(u.topupVnd)}</td><td class="p-2 font-semibold text-rose-700">${vnd(u.aiSpentVnd)}</td><td class="p-2 font-semibold">${vnd(u.balanceVnd)}</td><td class="p-2">${canWallet?`<form data-user="${u.id}" class="flex flex-wrap gap-1"><input name="amount" type="number" class="w-24 rounded-md border px-2 py-1" placeholder="+/- VND" required><input name="reason" class="w-32 rounded-md border px-2 py-1" placeholder="Lý do" required><button class="rounded-md bg-rose-400 px-2 py-1 font-semibold text-white hover:bg-rose-500">Lưu</button></form>`:'-'}</td></tr>`).join('');
        $('logs').innerHTML=(logs.items||[]).map(x=>`<tr><td class="p-2">${dt(x.created_at)}</td><td class="p-2">${x.user_id}</td><td class="p-2">${esc(x.model)}</td><td class="p-2">${x.usage_total_tokens ?? '-'}</td><td class="p-2">${esc(x.provider_cost_usd ?? '-')}</td><td class="p-2">${x.success?'OK':'Fail'}</td></tr>`).join('');
        $('payments').innerHTML=(payments.items||[]).map(x=>`<tr><td class="p-2">${dt(x.created_at)}</td><td class="p-2">${esc(x.reference_code)}</td><td class="p-2">${x.user_id}</td><td class="p-2 font-semibold">${vnd(x.amount_vnd)}</td><td class="p-2">${x.wallet_ledger_entry_id ?? '-'}</td></tr>`).join('');
        $('audit').innerHTML=(audit.items||[]).map(x=>`<tr><td class="p-2">${dt(x.created_at)}</td><td class="p-2">${esc(x.actor_email)}</td><td class="p-2">${esc(x.action)}</td><td class="p-2">${esc(x.target_type)} ${esc(x.target_id)}</td><td class="max-w-md truncate p-2">${esc(x.detail_json)}</td></tr>`).join('');
        renderConfig(config.runtime, roles.includes('owner'));
        $('products-admin').innerHTML=(products.items||[]).map(p=>`<div class="flex items-center justify-between gap-2 border border-slate-200 bg-slate-50 p-3"><span><b>${esc(p.code)}</b><br><small>${vnd(p.amountVnd)}</small></span><span class="text-xs">${p.active?'Active':'Tắt'}</span></div>`).join('');
        document.querySelectorAll('form[data-user]').forEach(form=>form.addEventListener('submit', async (e)=>{e.preventDefault(); const id=form.dataset.user; const fd=new FormData(form); const button=form.querySelector('button'); const label=button.textContent; button.disabled=true; button.textContent='Đang lưu...'; try { await fetch(`${api}/admin/users/${id}/wallet-adjustments`,{method:'POST',credentials:'include',headers:{'Content-Type':'application/json'},body:JSON.stringify({amountVnd:fd.get('amount'),reason:fd.get('reason')})}).then(async r=>{const d=await r.json();if(!r.ok)throw new Error(d.error||'Lỗi')}); showToast('Đã cập nhật số dư'); await load(); } catch(err){ showError(err.message); } finally {button.disabled=false;button.textContent=label;} }));
        document.querySelectorAll('form[data-role-user]').forEach(form=>form.addEventListener('submit', async (e)=>{e.preventDefault(); const id=form.dataset.roleUser; const roles=[...form.querySelectorAll('input[name="role"]:checked')].map(input=>input.value); const button=form.querySelector('button'); const label=button.textContent; button.disabled=true;button.textContent='Đang lưu...'; try { const r=await fetch(`${api}/admin/users/${id}/roles`,{method:'PUT',credentials:'include',headers:{'Content-Type':'application/json'},body:JSON.stringify({roles})}); const d=await r.json();if(!r.ok)throw new Error(d.error||'Lỗi'); showToast('Đã cập nhật quyền'); await load(); }catch(err){showError(err.message)}finally{button.disabled=false;button.textContent=label}}));
      } catch (e) { if (String(e.message)==='401' || String(e.message)==='403') window.location.href='/account'; else showError(e.message); }
    }
    function showError(msg){ $('error').textContent=msg; $('error').classList.remove('hidden'); }
    let toastTimer;
    function showToast(msg){const toast=$('toast');if(!toast)return;toast.textContent=msg;toast.classList.remove('hidden');clearTimeout(toastTimer);toastTimer=setTimeout(()=>toast.classList.add('hidden'),3000)}
    function field(label, name, value, type = 'text', hint = '') { return `<label class="block text-sm font-semibold text-slate-700">${label}<input name="${name}" type="${type}" value="${esc(value)}" class="mt-1 w-full rounded-md border border-slate-300 bg-white px-3 py-2 font-normal text-slate-900 focus:border-sky-500 focus:outline-none" required>${hint?`<span class="mt-1 block text-xs font-normal text-slate-500">${hint}</span>`:''}</label>`; }
    function renderConfig(runtime, owner){
      const ai=runtime.aiBilling, sepay=runtime.sepay;
      $('config').innerHTML=`<form data-config-form="ai_billing" class="rounded-lg border border-slate-200 bg-slate-50 p-4"><h3 class="font-bold text-slate-950">Tính phí AI</h3><div class="mt-4 grid gap-3">${field('Model OpenRouter','model',ai.model,'text','Ví dụ: google/gemini-2.5-flash-lite')}${field('Tỷ giá USD → VND','usdToVnd',ai.usdToVnd,'number','Số VND trên mỗi 1 USD')}${field('Hệ số markup','markupMultiplier',ai.markupMultiplier,'number','Giá user trả = cost provider × hệ số')}${field('Số dư tối thiểu','minimumBalanceVnd',ai.minimumBalanceVnd,'number','Không cho gọi AI dưới mức này')}${field('Phí tối thiểu mỗi lần','minimumChargeVnd',ai.minimumChargeVnd,'number','Đơn vị VND')}</div>${owner?'<button class="mt-4 rounded-md bg-rose-400 px-3 py-2 text-sm font-semibold text-white hover:bg-rose-500">Lưu phí AI</button>':'<p class="mt-4 text-xs text-slate-500">Chỉ owner mới được chỉnh.</p>'}</form><form data-config-form="sepay" class="rounded-lg border border-slate-200 bg-slate-50 p-4"><h3 class="font-bold text-slate-950">QR nạp tiền SePay</h3><p class="mt-1 text-xs text-slate-500">Chỉ cần URL VietQR gốc. Hệ thống tự thêm số tiền và nội dung JISHO + user ID.</p><div class="mt-4 grid gap-3">${field('URL QR','qrCodeUrl',sepay.qrCodeUrl,'url','Ví dụ: https://vietqr.app/img?...')}</div><img id="qr-preview" src="${esc(sepay.qrCodeUrl)}" alt="Xem trước QR nạp tiền" class="mt-4 aspect-square w-full border border-slate-200 bg-white object-contain" /><p id="qr-preview-error" class="mt-2 hidden text-xs text-rose-700">Không tải được QR từ URL này.</p>${owner?'<button class="mt-4 rounded-md bg-rose-400 px-3 py-2 text-sm font-semibold text-white hover:bg-rose-500">Lưu URL QR</button>':'<p class="mt-4 text-xs text-slate-500">Chỉ owner mới được chỉnh.</p>'}</form>`;
      document.querySelectorAll('form[data-config-form]').forEach(form=>{ if(!owner) form.querySelectorAll('input,button').forEach(el=>el.disabled=true); form.addEventListener('submit',async(e)=>{e.preventDefault(); if(!owner)return; const key=form.dataset.configForm; const raw=Object.fromEntries(new FormData(form).entries()); const value=key==='ai_billing'?{model:raw.model,usdToVnd:Number(raw.usdToVnd),markupMultiplier:Number(raw.markupMultiplier),minimumBalanceVnd:Number(raw.minimumBalanceVnd),minimumChargeVnd:Number(raw.minimumChargeVnd)}:{qrCodeUrl:raw.qrCodeUrl}; const button=form.querySelector('button'); const label=button.textContent;button.disabled=true;button.textContent='Đang lưu...'; try{const r=await fetch(`${api}/admin/config/${key}`,{method:'PUT',credentials:'include',headers:{'Content-Type':'application/json'},body:JSON.stringify({value})});const d=await r.json();if(!r.ok)throw new Error(d.error||'Không lưu được');showToast(key==='sepay'?'Đã lưu URL QR':'Đã lưu cấu hình tính phí');await load();}catch(err){showError(err.message)}finally{button.disabled=false;button.textContent=label}}); });
      const qrInput=document.querySelector('input[name="qrCodeUrl"]'), preview=$('qr-preview'), previewError=$('qr-preview-error'); if(qrInput&&preview){const updatePreview=()=>{previewError?.classList.add('hidden');preview.src=qrInput.value.trim()||'about:blank'};qrInput.addEventListener('input',updatePreview);preview.addEventListener('error',()=>previewError?.classList.remove('hidden'));}
    }
    const tabNames=new Set(['dashboard','operations','settings']);
    function activateTab(name, updateUrl=false){const tabName=tabNames.has(name)?name:'dashboard';document.querySelectorAll('[data-tab]').forEach(tab=>{const active=tab.dataset.tab===tabName;tab.classList.toggle('border-sky-600',active);tab.classList.toggle('text-sky-700',active);tab.classList.toggle('border-transparent',!active);tab.classList.toggle('text-slate-500',!active)});document.querySelectorAll('[data-panel]').forEach(panel=>panel.classList.toggle('hidden',panel.dataset.panel!==tabName));if(updateUrl){const url=new URL(window.location.href);url.searchParams.set('tab',tabName);window.history.pushState({},'',url)}}
    document.querySelectorAll('[data-tab]').forEach(tab=>tab.addEventListener('click',()=>activateTab(tab.dataset.tab,true)));
    window.addEventListener('popstate',()=>activateTab(new URLSearchParams(window.location.search).get('tab')||'dashboard'));
    activateTab(new URLSearchParams(window.location.search).get('tab')||'dashboard');
    $('user-search')?.addEventListener('change', ()=>load()); $('product-form')?.addEventListener('submit',async(event)=>{event.preventDefault();const form=event.currentTarget;const data=new FormData(form);const code=String(data.get('code')||'').trim();try{const r=await fetch(`${api}/admin/payment-products/${encodeURIComponent(code)}`,{method:'PUT',credentials:'include',headers:{'Content-Type':'application/json'},body:JSON.stringify({amountVnd:Number(data.get('amountVnd')),active:data.get('active')==='on'})});const d=await r.json();if(!r.ok)throw new Error(d.error||'Không lưu được gói');showToast('Đã lưu gói nạp');form.reset();form.active.checked=true;await load()}catch(error){showError(error instanceof Error?error.message:'Không lưu được gói')}}); $('logout')?.addEventListener('click',async()=>{await fetch(`${api}/auth/logout`,{method:'POST',credentials:'include'});location.href='/login'}); load();
  </script>
</Layout>
