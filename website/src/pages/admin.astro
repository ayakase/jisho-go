---
import Layout from '../layouts/Layout.astro';
const apiBase = import.meta.env.PUBLIC_API_BASE_URL?.replace(/\/$/, '') ?? 'http://localhost:8787';
---
<Layout>
  <main class="app-shell text-base-content" data-api-base={apiBase}>
    <aside class="app-sidebar">
      <a href="/account" class="mb-6 flex items-center gap-3 font-bold text-[#333333]">
        <span class="grid size-9 place-items-center rounded-lg border-2 border-[#fecaca] bg-[#ffe4e6] text-[#9f1239]">字</span>
        <span>Admin</span>
      </a>
      <nav class="grid gap-1">
        <button data-tab="dashboard" class="sidebar-link tab-active">Tổng quan</button>
        <button data-tab="operations" class="sidebar-link">Vận hành</button>
        <button data-tab="settings" class="sidebar-link">Cấu hình</button>
      </nav>
      <div class="mt-6 grid gap-1 border-t border-base-300 pt-4">
        <a href="/account" class="sidebar-link">Account</a>
        <button id="logout" class="sidebar-link">Đăng xuất</button>
      </div>
    </aside>
    <div class="app-main">
      <div id="error" class="alert alert-error mb-4 hidden"></div>
      <div id="toast" class="toast toast-top toast-end hidden" role="status"></div>
      <section id="overview" class="mb-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-4"></section>
      <div data-panel="dashboard" class="grid gap-6">
        <section class="panel-surface min-h-[calc(100vh-9rem)] rounded-xl p-5">
          <div class="grid gap-4">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <h2 class="text-lg font-bold">Người dùng &amp; ví</h2>
              <input id="user-search" class="input input-bordered" placeholder="Tìm email / tên" />
            </div>
            <div class="overflow-x-auto">
              <table class="table table-zebra text-sm">
                <thead><tr><th>ID</th><th>Người dùng</th><th>Vai trò</th><th>Đã cộng ví</th><th>Đã dùng AI</th><th>Số dư</th><th>Điều chỉnh</th></tr></thead>
                <tbody id="users"></tbody>
              </table>
            </div>
          </div>
        </section>
      </div>
      <div data-panel="operations" class="hidden grid gap-6 lg:grid-cols-2">
        <section class="panel-surface rounded-xl p-5"><div class="grid gap-4"><h2 class="text-lg font-bold">AI request logs</h2><div class="overflow-x-auto"><table class="table table-zebra text-xs"><thead><tr><th>Thời gian</th><th>User</th><th>Model</th><th>Tokens</th><th>Cost USD</th><th>Kết quả</th></tr></thead><tbody id="logs"></tbody></table></div></div></section>
        <section class="panel-surface rounded-xl p-5"><div class="grid gap-4"><h2 class="text-lg font-bold">Giao dịch SePay</h2><div class="overflow-x-auto"><table class="table table-zebra text-xs"><thead><tr><th>Thời gian</th><th>Reference</th><th>User</th><th>Số tiền</th><th>Ledger</th></tr></thead><tbody id="payments"></tbody></table></div></div></section>
        <section class="panel-surface rounded-xl p-5 lg:col-span-2"><div class="grid gap-4"><h2 class="text-lg font-bold">Audit log</h2><div class="overflow-x-auto"><table class="table table-zebra text-xs"><thead><tr><th>Thời gian</th><th>Actor</th><th>Action</th><th>Target</th><th>Chi tiết</th></tr></thead><tbody id="audit"></tbody></table></div></div></section>
      </div>
      <div data-panel="settings" class="hidden">
        <section class="panel-surface min-h-[calc(100vh-2rem)] rounded-xl p-5">
          <div class="grid gap-4">
            <h2 class="text-lg font-bold">Cấu hình ứng dụng</h2>
            <div id="config" class="grid gap-5 md:grid-cols-2"></div>
            <div class="divider"></div>
            <h3 class="text-lg font-bold">Gói nạp tiền</h3>
            <form id="product-form" class="flex flex-wrap gap-2">
              <input name="code" class="input input-bordered" placeholder="topup_200k" required>
              <input name="amountVnd" type="number" min="1000" class="input input-bordered w-36" placeholder="Số tiền VND" required>
              <label class="label cursor-pointer gap-2 px-2 text-sm"><input name="active" type="checkbox" checked class="checkbox checkbox-sm"> Active</label>
              <button class="btn btn-primary btn-sm">Thêm / lưu gói</button>
            </form>
            <div id="products-admin" class="grid gap-2 sm:grid-cols-2 lg:grid-cols-3"></div>
          </div>
        </section>
      </div>
    </div>
  </main>
  <script is:inline>
    const root = document.querySelector('main[data-api-base]'); const api = root?.dataset.apiBase || ''; const $ = (id) => document.getElementById(id);
    const esc = (v) => String(v ?? '').replace(/[&<>"']/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    const vnd = (v) => `${new Intl.NumberFormat('vi-VN').format(Number(v || 0))} VND`;
    const dt = (v) => { const d = new Date(String(v || '').includes(' ') ? `${v.replace(' ','T')}Z` : v); return Number.isNaN(d.getTime()) ? esc(v) : new Intl.DateTimeFormat('vi-VN',{dateStyle:'short',timeStyle:'short',timeZone:'Asia/Ho_Chi_Minh'}).format(d); };
    async function get(path) { const r = await fetch(`${api}${path}`, { credentials:'include' }); const d = await r.json().catch(()=>({})); if (!r.ok) throw new Error(d.error || `${r.status}`); return d; }
    async function load() {
      try {
        const me = await get('/admin/me');
        const roles = me.roles || [];
        const search = encodeURIComponent($('user-search')?.value || '');
        const [overview, users, logs, payments, config, audit, products] = await Promise.all([get('/admin/overview'), get(`/admin/users?limit=100&search=${search}`), get('/admin/logs?limit=50'), get('/admin/sepay-transactions?limit=50'), get('/admin/config'), get('/admin/audit-logs?limit=50'), get('/admin/payment-products')]);
        $('overview').innerHTML = [['Users',overview.users],['Đã cộng ví',vnd(overview.walletTopupVnd)],['Đã dùng AI',vnd(overview.walletAiSpentVnd)],['Ví đang lưu',vnd(overview.walletBalanceVnd)]].map(([k,val])=>`<div class="extension-card rounded-xl p-4"><p class="text-xs uppercase text-[#6b7280]">${k}</p><p class="mt-1 text-2xl font-bold text-[#111827]">${esc(val)}</p></div>`).join('');
        const canWallet = roles.includes('owner') || roles.includes('admin');
        const canRoles = roles.includes('owner');
        $('users').innerHTML = (users.items||[]).map(u=>`<tr><td>${u.id}</td><td><div class="font-semibold">${esc(u.display_name || '-')}</div><div class="text-xs opacity-70">${esc(u.email)}</div></td><td>${canRoles?`<form data-role-user="${u.id}" class="space-y-2"><div class="flex flex-wrap gap-x-3 gap-y-1 text-xs">${['owner','admin','support','viewer'].map(role=>`<label class="inline-flex items-center gap-1"><input class="checkbox checkbox-xs checkbox-primary" type="checkbox" name="role" value="${role}" ${(u.roles||[]).includes(role)?'checked':''}>${role}</label>`).join('')}</div><button class="btn btn-outline btn-xs">Lưu quyền</button></form>`:esc((u.roles||[]).join(', ')||'-')}</td><td class="font-semibold text-[#047857]">${vnd(u.topupVnd)}</td><td class="font-semibold text-[#be123c]">${vnd(u.aiSpentVnd)}</td><td class="font-semibold">${vnd(u.balanceVnd)}</td><td>${canWallet?`<form data-user="${u.id}" class="flex flex-wrap gap-1"><input name="amount" type="number" class="input input-bordered input-sm w-24" placeholder="+/- VND" required><input name="reason" class="input input-bordered input-sm w-32" placeholder="Lý do" required><button class="btn btn-primary btn-xs">Lưu</button></form>`:'-'}</td></tr>`).join('');
        $('logs').innerHTML=(logs.items||[]).map(x=>`<tr><td>${dt(x.created_at)}</td><td>${x.user_id}</td><td>${esc(x.model)}</td><td>${x.usage_total_tokens ?? '-'}</td><td>${esc(x.provider_cost_usd ?? '-')}</td><td>${x.success?'OK':'Fail'}</td></tr>`).join('');
        $('payments').innerHTML=(payments.items||[]).map(x=>`<tr><td>${dt(x.created_at)}</td><td>${esc(x.reference_code)}</td><td>${x.user_id}</td><td class="font-semibold">${vnd(x.amount_vnd)}</td><td>${x.wallet_ledger_entry_id ?? '-'}</td></tr>`).join('');
        $('audit').innerHTML=(audit.items||[]).map(x=>`<tr><td>${dt(x.created_at)}</td><td>${esc(x.actor_email)}</td><td>${esc(x.action)}</td><td>${esc(x.target_type)} ${esc(x.target_id)}</td><td class="max-w-md truncate">${esc(x.detail_json)}</td></tr>`).join('');
        renderConfig(config.runtime, roles.includes('owner'));
        $('products-admin').innerHTML=(products.items||[]).map(p=>`<div class="rounded-lg border border-base-300 bg-base-200 p-4"><div class="flex items-center justify-between gap-2"><span><b>${esc(p.code)}</b><br><small>${vnd(p.amountVnd)}</small></span><span class="${p.active?'extension-pill':'extension-muted-pill'} rounded-full px-2 py-0.5 text-xs font-bold">${p.active?'Active':'Tắt'}</span></div></div>`).join('');
        document.querySelectorAll('form[data-user]').forEach(form=>form.addEventListener('submit', async (e)=>{e.preventDefault(); const id=form.dataset.user; const fd=new FormData(form); const button=form.querySelector('button'); const label=button.textContent; button.disabled=true; button.textContent='Đang lưu...'; try { await fetch(`${api}/admin/users/${id}/wallet-adjustments`,{method:'POST',credentials:'include',headers:{'Content-Type':'application/json'},body:JSON.stringify({amountVnd:fd.get('amount'),reason:fd.get('reason')})}).then(async r=>{const d=await r.json();if(!r.ok)throw new Error(d.error||'Lỗi')}); showToast('Đã cập nhật số dư'); await load(); } catch(err){ showError(err.message); } finally {button.disabled=false;button.textContent=label;} }));
        document.querySelectorAll('form[data-role-user]').forEach(form=>form.addEventListener('submit', async (e)=>{e.preventDefault(); const id=form.dataset.roleUser; const roles=[...form.querySelectorAll('input[name="role"]:checked')].map(input=>input.value); const button=form.querySelector('button'); const label=button.textContent; button.disabled=true;button.textContent='Đang lưu...'; try { const r=await fetch(`${api}/admin/users/${id}/roles`,{method:'PUT',credentials:'include',headers:{'Content-Type':'application/json'},body:JSON.stringify({roles})}); const d=await r.json();if(!r.ok)throw new Error(d.error||'Lỗi'); showToast('Đã cập nhật quyền'); await load(); }catch(err){showError(err.message)}finally{button.disabled=false;button.textContent=label}}));
      } catch (e) { if (String(e.message)==='401' || String(e.message)==='403') window.location.href='/account'; else showError(e.message); }
    }
    function showError(msg){ $('error').textContent=msg; $('error').classList.remove('hidden'); }
    let toastTimer;
    function showToast(msg){const toast=$('toast');if(!toast)return;toast.innerHTML=`<div class="alert border-primary/25 bg-primary text-primary-content shadow-lg"><span>${esc(msg)}</span></div>`;toast.classList.remove('hidden');clearTimeout(toastTimer);toastTimer=setTimeout(()=>toast.classList.add('hidden'),3000)}
    function field(label, name, value, type = 'text', hint = '') { return `<label class="form-control"><div class="label"><span class="label-text font-semibold">${label}</span></div><input name="${name}" type="${type}" value="${esc(value)}" class="input input-bordered" required>${hint?`<div class="label"><span class="label-text-alt opacity-70">${hint}</span></div>`:''}</label>`; }
    function renderConfig(runtime, owner){
      const ai=runtime.aiBilling, sepay=runtime.sepay;
      $('config').innerHTML=`<form data-config-form="ai_billing" class="rounded-lg border border-base-300 bg-base-200 p-4"><h3 class="font-bold">Tính phí AI</h3><div class="mt-4 grid gap-3">${field('Model OpenRouter','model',ai.model,'text')}${field('Tỷ giá USD → VND','usdToVnd',ai.usdToVnd,'number')}${field('Hệ số markup','markupMultiplier',ai.markupMultiplier,'number')}${field('Số dư tối thiểu','minimumBalanceVnd',ai.minimumBalanceVnd,'number')}${field('Phí tối thiểu','minimumChargeVnd',ai.minimumChargeVnd,'number')}</div>${owner?'<button class="btn btn-primary mt-4">Lưu</button>':'<p class="mt-4 text-xs opacity-70">Owner only</p>'}</form><form data-config-form="sepay" class="rounded-lg border border-base-300 bg-base-200 p-4"><h3 class="font-bold">SePay QR</h3><div class="mt-4 grid gap-3">${field('URL QR','qrCodeUrl',sepay.qrCodeUrl,'url')}</div><img id="qr-preview" src="${esc(sepay.qrCodeUrl)}" alt="QR nạp tiền" class="mt-4 aspect-square w-full rounded-box border border-base-300 object-contain bg-base-100" /><p id="qr-preview-error" class="alert alert-error mt-2 hidden text-xs">QR lỗi</p>${owner?'<button class="btn btn-primary mt-4">Lưu</button>':'<p class="mt-4 text-xs opacity-70">Owner only</p>'}</form>`;
      document.querySelectorAll('form[data-config-form]').forEach(form=>{ if(!owner) form.querySelectorAll('input,button').forEach(el=>el.disabled=true); form.addEventListener('submit',async(e)=>{e.preventDefault(); if(!owner)return; const key=form.dataset.configForm; const raw=Object.fromEntries(new FormData(form).entries()); const value=key==='ai_billing'?{model:raw.model,usdToVnd:Number(raw.usdToVnd),markupMultiplier:Number(raw.markupMultiplier),minimumBalanceVnd:Number(raw.minimumBalanceVnd),minimumChargeVnd:Number(raw.minimumChargeVnd)}:{qrCodeUrl:raw.qrCodeUrl}; const button=form.querySelector('button'); const label=button.textContent;button.disabled=true;button.textContent='Đang lưu...'; try{const r=await fetch(`${api}/admin/config/${key}`,{method:'PUT',credentials:'include',headers:{'Content-Type':'application/json'},body:JSON.stringify({value})});const d=await r.json();if(!r.ok)throw new Error(d.error||'Không lưu được');showToast(key==='sepay'?'Đã lưu URL QR':'Đã lưu cấu hình tính phí');await load();}catch(err){showError(err.message)}finally{button.disabled=false;button.textContent=label}}); });
      const qrInput=document.querySelector('input[name="qrCodeUrl"]'), preview=$('qr-preview'), previewError=$('qr-preview-error'); if(qrInput&&preview){const updatePreview=()=>{previewError?.classList.add('hidden');preview.src=qrInput.value.trim()||'about:blank'};qrInput.addEventListener('input',updatePreview);preview.addEventListener('error',()=>previewError?.classList.remove('hidden'));}
    }
    const tabNames=new Set(['dashboard','operations','settings']);
    function activateTab(name, updateUrl=false){const tabName=tabNames.has(name)?name:'dashboard';document.querySelectorAll('[data-tab]').forEach(tab=>{const active=tab.dataset.tab===tabName;tab.classList.toggle('tab-active',active)});document.querySelectorAll('[data-panel]').forEach(panel=>panel.classList.toggle('hidden',panel.dataset.panel!==tabName));if(updateUrl){const url=new URL(window.location.href);url.searchParams.set('tab',tabName);window.history.pushState({},'',url)}}
    document.querySelectorAll('[data-tab]').forEach(tab=>tab.addEventListener('click',()=>activateTab(tab.dataset.tab,true)));
    window.addEventListener('popstate',()=>activateTab(new URLSearchParams(window.location.search).get('tab')||'dashboard'));
    activateTab(new URLSearchParams(window.location.search).get('tab')||'dashboard');
    $('user-search')?.addEventListener('change', ()=>load()); $('product-form')?.addEventListener('submit',async(event)=>{event.preventDefault();const form=event.currentTarget;const data=new FormData(form);const code=String(data.get('code')||'').trim();try{const r=await fetch(`${api}/admin/payment-products/${encodeURIComponent(code)}`,{method:'PUT',credentials:'include',headers:{'Content-Type':'application/json'},body:JSON.stringify({amountVnd:Number(data.get('amountVnd')),active:data.get('active')==='on'})});const d=await r.json();if(!r.ok)throw new Error(d.error||'Không lưu được gói');showToast('Đã lưu gói nạp');form.reset();form.active.checked=true;await load()}catch(error){showError(error instanceof Error?error.message:'Không lưu được gói')}}); $('logout')?.addEventListener('click',async()=>{await fetch(`${api}/auth/logout`,{method:'POST',credentials:'include'});location.href='/login'}); load();
  </script>
</Layout>
