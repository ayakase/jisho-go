---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main class="landing-page min-h-screen bg-base-100 text-base-content">
		<nav class="navbar sticky top-0 z-50 border-b border-base-300 bg-white/90 px-4 backdrop-blur-xl sm:px-6 lg:px-8">
			<div class="navbar-start">
				<a href="/" class="flex items-center gap-3 font-bold text-[#111827]">
					<span class="grid size-9 place-items-center rounded-lg border-2 border-[#fecaca] bg-[#ffe4e6] text-[#9f1239]">字</span>
					<span>Jisho Go</span>
				</a>
			</div>
			<div class="navbar-center hidden lg:flex">
				<div class="join">
					<a class="btn join-item btn-sm bg-white" href="#popup">Popup</a>
					<a class="btn join-item btn-sm bg-white" href="#hover">Hover</a>
					<a class="btn join-item btn-sm bg-white" href="#ai">AI</a>
					<a class="btn join-item btn-sm bg-white" href="#settings">Tùy chỉnh</a>
				</div>
			</div>
			<div class="navbar-end gap-2">
				<a class="btn btn-ghost btn-sm" href="/login">Login</a>
				<a class="btn btn-primary btn-sm" href="/register">Cài extension</a>
			</div>
		</nav>

		<section class="hero landing-hero min-h-[calc(100vh-64px)] overflow-hidden border-b border-base-300">
			<div class="hero-content grid w-full max-w-none gap-10 px-4 py-10 sm:px-6 lg:grid-cols-[0.76fr_1.24fr] lg:px-8 xl:px-12">
				<div class="max-w-2xl">
					<div class="extension-pill mb-5 inline-flex rounded-full px-3 py-1.5 text-sm font-bold">Japanese reading extension</div>
					<h1 class="text-5xl font-black leading-[1.02] text-[#111827] sm:text-6xl lg:text-7xl">
						Đọc ở đâu, tra ngay ở đó.
					</h1>
					<p class="mt-6 max-w-xl text-lg leading-8 text-[#4b5563]">
						Bôi đen câu, hover Kanji, dịch đoạn, hỏi AI về vocab và grammar mà không rời khỏi trang đang đọc.
					</p>
					<div class="mt-8 flex flex-wrap gap-3">
						<a class="btn btn-primary btn-lg" href="/register">Cài extension</a>
						<a class="btn btn-outline btn-lg border-base-300 bg-white text-[#374151]" href="#popup">Xem flow</a>
					</div>
					<div class="mt-8 flex flex-wrap gap-2">
						<kbd class="kbd kbd-sm">select</kbd>
						<kbd class="kbd kbd-sm">hover</kbd>
						<kbd class="kbd kbd-sm">AI</kbd>
						<kbd class="kbd kbd-sm">save</kbd>
					</div>
				</div>

				<div class="landing-stage">
					<div class="hover-3d landing-hover-3d">
						<div class="indicator w-full">
							<span class="indicator-item badge badge-primary shadow-md">Live popup</span>
							<div class="mockup-browser w-full border border-base-300 bg-white shadow-2xl">
								<div class="mockup-browser-toolbar border-b border-base-300">
									<div class="input border border-base-300 bg-base-200 text-sm text-[#6b7280]">mainichi.jp/nihongo/article</div>
								</div>
								<div class="landing-reader-grid bg-white">
									<div class="min-h-[500px] p-5 sm:p-7">
										<div class="mb-5 flex flex-wrap items-center gap-2">
											<span class="badge border-[#fca5a5] bg-[#fee2e2] text-[#991b1b]">Selection</span>
											<span class="badge border-base-300 bg-base-200">Kanji dict</span>
											<span class="badge border-base-300 bg-base-200">Vocab</span>
											<span class="badge border-base-300 bg-base-200">Translate</span>
										</div>
										<article class="space-y-5">
											<p class="jp-text text-3xl font-black leading-relaxed text-[#111827] sm:text-4xl">
												新しい言葉に出会うたび、読む力は少しずつ伸びていく。
											</p>
											<div class="space-y-3">
												<div class="h-3 w-11/12 rounded-full bg-base-200"></div>
												<div class="h-3 w-9/12 rounded-full bg-base-200"></div>
												<div class="h-3 w-10/12 rounded-full bg-base-200"></div>
											</div>
											<p class="jp-text max-w-2xl text-2xl font-bold leading-relaxed text-[#374151]">
												<span class="landing-mark">出会うたび</span>、知らない表現が自然に自分の言葉になる。
											</p>
										</article>

										<div class="landing-popup extension-card mt-8 rounded-xl p-4">
											<div class="tabs tabs-box bg-base-200">
												<span class="tab tab-active bg-[#fee2e2] text-[#991b1b]">Vocab</span>
												<span class="tab">Kanji</span>
												<span class="tab">Explain</span>
											</div>
											<div class="mt-4 grid gap-3 sm:grid-cols-[130px_minmax(0,1fr)]">
												<div class="rounded-lg border border-base-300 bg-base-200 p-3">
													<p class="jp-text text-4xl font-black text-primary">出会う</p>
													<p class="mt-1 text-sm font-semibold text-[#6b7280]">であう</p>
												</div>
												<div class="space-y-3">
													<div class="h-2 w-11/12 rounded-full bg-[#fee2e2]"></div>
													<div class="h-2 w-8/12 rounded-full bg-base-300"></div>
													<div class="flex flex-wrap gap-2">
														<span class="badge badge-outline">JLPT</span>
														<span class="badge badge-outline">romaji</span>
														<span class="badge badge-primary">save</span>
													</div>
												</div>
											</div>
										</div>
									</div>

									<aside class="landing-side-panel border-t border-base-300 bg-base-200 p-4 lg:border-l lg:border-t-0">
										<div class="mockup-phone scale-[0.82] origin-top">
											<div class="mockup-phone-camera"></div>
											<div class="mockup-phone-display bg-white p-4">
												<div class="mb-3 flex items-center justify-between">
													<span class="font-bold">Extension</span>
													<input type="checkbox" class="toggle toggle-primary toggle-sm" checked />
												</div>
												<div class="space-y-3">
													<div class="rounded-lg border border-base-300 bg-base-200 p-3">
														<p class="text-xs font-bold text-[#6b7280]">Hover mode</p>
														<p class="mt-1 font-bold">Từng Kanji / Cả đoạn</p>
													</div>
													<div class="rounded-lg border border-base-300 bg-white p-3">
														<p class="text-xs font-bold text-[#6b7280]">Popup</p>
														<input type="range" min="0" max="100" value="72" class="range range-primary range-xs mt-3" />
													</div>
													<div class="rounded-lg border border-[#bbf7d0] bg-[#ecfdf5] p-3 text-[#065f46]">
														<p class="text-xs font-bold">AI explain</p>
														<p class="text-2xl font-black">Ready</p>
													</div>
												</div>
											</div>
										</div>
									</aside>
								</div>
							</div>
						</div>
						<div></div>
						<div></div>
						<div></div>
						<div></div>
						<div></div>
						<div></div>
						<div></div>
						<div></div>
					</div>
				</div>
			</div>
		</section>

		<section id="popup" class="bg-white py-16 sm:py-20">
			<div class="w-full px-4 sm:px-6 lg:px-8 xl:px-12">
				<div class="grid items-end gap-6 lg:grid-cols-[0.78fr_1.22fr]">
					<div>
						<div class="extension-pill mb-4 inline-flex rounded-full px-3 py-1 text-sm font-bold">Core flow</div>
						<h2 class="max-w-2xl text-4xl font-black leading-tight text-[#111827] sm:text-5xl">
							Popup là trung tâm, không phải dashboard.
						</h2>
					</div>
					<div class="stats stats-vertical border border-base-300 bg-base-100 shadow-sm sm:stats-horizontal">
						<div class="stat">
							<div class="stat-title">Trigger</div>
							<div class="stat-value text-2xl">Select</div>
						</div>
						<div class="stat">
							<div class="stat-title">Result</div>
							<div class="stat-value text-2xl text-primary">Dict + AI</div>
						</div>
						<div class="stat">
							<div class="stat-title">Memory</div>
							<div class="stat-value text-2xl">Saved</div>
						</div>
					</div>
				</div>

				<div class="carousel carousel-center mt-10 w-full gap-4 rounded-box">
					<div class="carousel-item w-[86vw] max-w-md">
						<div class="landing-feature-tile w-full">
							<div class="text-5xl">選</div>
							<h3>Bôi đen mở popup</h3>
							<p>Tức thì hoặc qua nút nhỏ.</p>
						</div>
					</div>
					<div class="carousel-item w-[86vw] max-w-md">
						<div class="landing-feature-tile w-full">
							<div class="text-5xl">漢</div>
							<h3>Kanji + vocab local</h3>
							<p>Tra nhanh, có đọc, nghĩa, ví dụ.</p>
						</div>
					</div>
					<div class="carousel-item w-[86vw] max-w-md">
						<div class="landing-feature-tile w-full">
							<div class="text-5xl">文</div>
							<h3>Hover cả đoạn</h3>
							<p>Dịch, vocab, Kanji theo đoạn đang trỏ.</p>
						</div>
					</div>
					<div class="carousel-item w-[86vw] max-w-md">
						<div class="landing-feature-tile w-full">
							<div class="text-5xl">AI</div>
							<h3>Explain ngữ cảnh</h3>
							<p>Tách câu, từ vựng, grammar, note.</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<section id="hover" class="landing-soft-band border-y border-base-300 py-16 sm:py-20">
			<div class="grid w-full gap-10 px-4 sm:px-6 lg:grid-cols-[1.1fr_0.9fr] lg:px-8 xl:px-12">
				<div class="mockup-browser border border-base-300 bg-white shadow-xl">
					<div class="mockup-browser-toolbar border-b border-base-300">
						<div class="input border border-base-300 bg-base-200 text-sm text-[#6b7280]">hover paragraph</div>
					</div>
					<div class="p-5 sm:p-7">
						<div class="diff aspect-[16/9] rounded-xl border border-base-300" tabindex="0">
							<div class="diff-item-1" role="img">
								<div class="grid h-full place-items-center bg-white p-6">
									<p class="jp-text max-w-xl text-3xl font-black leading-relaxed text-[#111827]">
										難しい文章でも、文脈をつかめば読みやすくなる。
									</p>
								</div>
							</div>
							<div class="diff-item-2" role="img">
								<div class="grid h-full place-items-center bg-[#fff1f2] p-6">
									<div class="max-w-md rounded-xl border border-[#fca5a5] bg-white p-4 shadow-lg">
										<p class="text-xs font-black uppercase text-[#991b1b]">Hover popup</p>
										<p class="mt-2 text-sm leading-6 text-[#374151]">Bản dịch nhanh + vocab rút gọn + Kanji chính.</p>
										<div class="mt-3 flex flex-wrap gap-2">
											<span class="badge badge-primary">文脈</span>
											<span class="badge">つかむ</span>
											<span class="badge">読みやすい</span>
										</div>
									</div>
								</div>
							</div>
							<div class="diff-resizer"></div>
						</div>
					</div>
				</div>

				<div class="flex flex-col justify-center">
					<div class="extension-pill mb-4 inline-flex w-fit rounded-full px-3 py-1 text-sm font-bold">Hover mode</div>
					<h2 class="text-4xl font-black leading-tight text-[#111827]">Không cần chọn text cũng tra được.</h2>
					<ul class="timeline timeline-vertical mt-8">
						<li>
							<div class="timeline-start text-sm font-bold text-[#6b7280]">01</div>
							<div class="timeline-middle"><span class="status status-primary"></span></div>
							<div class="timeline-end timeline-box border-base-300 bg-white">Từng Kanji</div>
							<hr class="bg-base-300" />
						</li>
						<li>
							<hr class="bg-base-300" />
							<div class="timeline-start text-sm font-bold text-[#6b7280]">02</div>
							<div class="timeline-middle"><span class="status status-primary"></span></div>
							<div class="timeline-end timeline-box border-base-300 bg-white">Cả đoạn văn</div>
							<hr class="bg-base-300" />
						</li>
						<li>
							<hr class="bg-base-300" />
							<div class="timeline-start text-sm font-bold text-[#6b7280]">03</div>
							<div class="timeline-middle"><span class="status status-primary"></span></div>
							<div class="timeline-end timeline-box border-base-300 bg-white">Delay tùy chỉnh</div>
						</li>
					</ul>
				</div>
			</div>
		</section>

		<section id="ai" class="bg-white py-16 sm:py-20">
			<div class="w-full px-4 sm:px-6 lg:px-8 xl:px-12">
				<div class="mb-10 flex flex-col justify-between gap-5 lg:flex-row lg:items-end">
					<div>
						<div class="extension-pill mb-4 inline-flex rounded-full px-3 py-1 text-sm font-bold">AI Explain</div>
						<h2 class="max-w-2xl text-4xl font-black leading-tight text-[#111827]">Một câu được bẻ ra thành thứ học được.</h2>
					</div>
					<div class="steps steps-horizontal overflow-x-auto">
						<div class="step step-primary">Sentence</div>
						<div class="step step-primary">Vocab</div>
						<div class="step step-primary">Grammar</div>
						<div class="step">Saved</div>
					</div>
				</div>

				<div class="grid gap-6 lg:grid-cols-[0.95fr_1.05fr]">
					<div class="stack">
						<div class="landing-ai-card border-[#fecaca] bg-[#fff1f2]">
							<p class="jp-text text-3xl font-black">読みやすくなる</p>
							<p class="mt-2 text-[#6b7280]">sentence meaning</p>
						</div>
						<div class="landing-ai-card bg-white">
							<p class="font-black">Vocabularies</p>
							<div class="mt-3 flex flex-wrap gap-2">
								<span class="badge badge-primary">文脈</span>
								<span class="badge">難しい</span>
								<span class="badge">つかむ</span>
							</div>
						</div>
						<div class="landing-ai-card bg-base-200">
							<p class="font-black">Grammar</p>
							<p class="mt-2 text-sm text-[#6b7280]">~ば / conditional pattern</p>
						</div>
					</div>

					<div class="mockup-code border border-base-300 bg-[#111827] text-primary-content shadow-xl">
						<pre data-prefix="$"><code>explain selected sentence</code></pre>
						<pre data-prefix=">" class="text-success"><code>hiragana: よみやすくなる</code></pre>
						<pre data-prefix=">" class="text-warning"><code>vocab: 3 items</code></pre>
						<pre data-prefix=">" class="text-info"><code>grammar: conditional nuance</code></pre>
						<pre data-prefix=">" class="text-primary"><code>saved to history</code></pre>
					</div>
				</div>
			</div>
		</section>

		<section id="settings" class="landing-soft-band border-y border-base-300 py-16 sm:py-20">
			<div class="grid w-full gap-10 px-4 sm:px-6 lg:grid-cols-[0.8fr_1.2fr] lg:px-8 xl:px-12">
				<div>
					<div class="extension-pill mb-4 inline-flex rounded-full px-3 py-1 text-sm font-bold">Fine controls</div>
					<h2 class="text-4xl font-black leading-tight text-[#111827]">Extension chỉnh được theo cách đọc của từng người.</h2>
				</div>

				<div class="grid gap-4 md:grid-cols-2">
					<fieldset class="fieldset rounded-xl border border-base-300 bg-white p-5 shadow-sm">
						<legend class="fieldset-legend text-base">Popup trigger</legend>
						<div class="join w-full">
							<button class="btn join-item btn-primary flex-1">Tức thì</button>
							<button class="btn join-item flex-1 bg-white">Nút nhỏ</button>
						</div>
					</fieldset>
					<fieldset class="fieldset rounded-xl border border-base-300 bg-white p-5 shadow-sm">
						<legend class="fieldset-legend text-base">Popup position</legend>
						<select class="select select-bordered w-full">
							<option>Ngay cạnh vùng chọn</option>
							<option>Nhớ vị trí kéo thả</option>
							<option>Cố định ở góc</option>
						</select>
					</fieldset>
					<fieldset class="fieldset rounded-xl border border-base-300 bg-white p-5 shadow-sm">
						<legend class="fieldset-legend text-base">Độ mờ</legend>
						<input type="range" min="0" max="100" value="82" class="range range-primary" />
					</fieldset>
					<fieldset class="fieldset rounded-xl border border-base-300 bg-white p-5 shadow-sm">
						<legend class="fieldset-legend text-base">Paragraph hover</legend>
						<div class="flex flex-wrap gap-3">
							<label class="label cursor-pointer gap-2"><input type="checkbox" class="checkbox checkbox-primary checkbox-sm" checked />Dịch</label>
							<label class="label cursor-pointer gap-2"><input type="checkbox" class="checkbox checkbox-primary checkbox-sm" checked />Vocab</label>
							<label class="label cursor-pointer gap-2"><input type="checkbox" class="checkbox checkbox-primary checkbox-sm" />Kanji</label>
						</div>
					</fieldset>
				</div>
			</div>
		</section>

		<section class="bg-white px-4 py-14 sm:px-6 lg:px-8 xl:px-12">
			<div class="flex flex-col items-start justify-between gap-5 rounded-xl border border-base-300 bg-base-200 p-5 sm:flex-row sm:items-center">
				<div>
					<p class="text-sm font-bold uppercase text-[#6b7280]">Account chỉ là sync</p>
					<h2 class="mt-1 text-2xl font-black text-[#111827]">History, saved items, ví AI và export khi cần.</h2>
				</div>
				<div class="flex gap-2">
					<a class="btn btn-outline bg-white" href="/account">Account</a>
					<a class="btn btn-primary" href="/register">Cài extension</a>
				</div>
			</div>
		</section>
	</main>
</Layout>
