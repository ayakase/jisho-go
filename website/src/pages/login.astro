---
import Layout from '../layouts/Layout.astro';

const apiBase = import.meta.env.PUBLIC_API_BASE_URL?.replace(/\/$/, '') ?? 'http://localhost:8787';
const loginUrl = `${apiBase}/auth/google/start?next=%2Faccount`;
const meUrl = `${apiBase}/auth/me`;
const error = Astro.url.searchParams.get('error');
---

<Layout>
	<main class="min-h-screen bg-base-200 px-4 py-12 text-base-content" data-login-url={loginUrl} data-me-url={meUrl}>
		<div class="mx-auto flex min-h-[calc(100vh-6rem)] max-w-md items-center">
			<div class="extension-card w-full rounded-xl p-5">
				<div class="grid gap-5">
					<div>
						<h1 class="card-title text-3xl">Login</h1>
						<p class="mt-2 text-base-content/70">Đăng nhập bằng Google để đồng bộ cài đặt và lịch sử học.</p>
					</div>

					{error && <div class="alert alert-error text-sm">{error}</div>}

					<button id="google-login" type="button" class="btn btn-primary w-full">Tiếp tục với Google</button>

					<p class="text-sm text-base-content/70">
						Chưa có tài khoản?
						<a href="/register" class="link link-primary">Đăng ký</a>
					</p>
				</div>
			</div>
		</div>
	</main>
	<script is:inline>
		const mainEl = document.querySelector('main[data-login-url]');
		const loginUrl = mainEl?.getAttribute('data-login-url') || '';
		const meUrl = mainEl?.getAttribute('data-me-url') || '';
		const btn = document.getElementById('google-login');

		if (btn) {
			btn.addEventListener('click', () => {
				window.location.href = loginUrl;
			});
		}

		(async () => {
			try {
				const res = await fetch(meUrl, { credentials: 'include' });
				if (!res.ok) return;
				const data = await res.json();
				if (data?.user) window.location.href = '/account';
			} catch {
			}
		})();
	</script>
</Layout>
