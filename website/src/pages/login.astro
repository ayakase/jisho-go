---
import Layout from '../layouts/Layout.astro';

const apiBase = import.meta.env.PUBLIC_API_BASE_URL?.replace(/\/$/, '') ?? 'http://localhost:8787';
const loginUrl = `${apiBase}/auth/google/start?next=%2Faccount`;
const meUrl = `${apiBase}/auth/me`;
const error = Astro.url.searchParams.get('error');
---

<Layout>
	<main class="min-h-screen bg-slate-50 px-6 py-12 text-slate-800" data-login-url={loginUrl} data-me-url={meUrl}>
		<div class="mx-auto w-full max-w-md">
			<a href="/" class="mb-6 inline-flex text-sm text-slate-600 hover:text-slate-900">← Về trang chủ</a>
			<section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
				<h1 class="text-2xl font-bold tracking-[-0.02em]">Login</h1>
				<p class="mt-2 text-sm text-slate-600">Đăng nhập bằng Google để đồng bộ cài đặt và lịch sử học.</p>

				{error && (
					<div class="mt-4 rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700">
						{error}
					</div>
				)}

				<button
					id="google-login"
					type="button"
					class="mt-6 inline-flex w-full items-center justify-center rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-800 transition-colors hover:bg-slate-100"
				>
					Tiếp tục với Google
				</button>

				<p class="mt-4 text-sm text-slate-600">
					Chưa có tài khoản?
					<a href="/register" class="font-semibold text-rose-600 hover:text-rose-700">Đăng ký</a>
				</p>
			</section>
		</div>
	</main>
	<script is:inline>
		const mainEl = document.querySelector('main[data-login-url]');
		const loginUrl = mainEl?.getAttribute('data-login-url') || '';
		const meUrl = mainEl?.getAttribute('data-me-url') || '';
		const btn = document.getElementById('google-login');

		if (btn) {
			btn.addEventListener('click', () => {
				window.location.href = loginUrl;
			});
		}

		(async () => {
			try {
				const res = await fetch(meUrl, { credentials: 'include' });
				if (!res.ok) return;
				const data = await res.json();
				if (data?.user) {
					window.location.href = '/account';
				}
			} catch {
				// no-op
			}
		})();
	</script>
</Layout>
