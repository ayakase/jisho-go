---
import Layout from '../layouts/Layout.astro';

const apiBase = import.meta.env.PUBLIC_API_BASE_URL?.replace(/\/$/, '') ?? 'http://localhost:8787';
const registerUrl = `${apiBase}/auth/google/start?next=%2Faccount`;
const meUrl = `${apiBase}/auth/me`;
---

<Layout>
	<main class="min-h-screen bg-base-200 px-4 py-12 text-base-content" data-register-url={registerUrl} data-me-url={meUrl}>
		<div class="mx-auto flex min-h-[calc(100vh-6rem)] max-w-md items-center">
			<div class="extension-card w-full rounded-xl p-5">
				<div class="grid gap-5">
					<div>
						<h1 class="card-title text-3xl">Register</h1>
						<p class="mt-2 text-base-content/70">Đăng ký nhanh bằng Google. User sẽ được tạo tự động ở lần đầu.</p>
					</div>

					<button id="google-register" type="button" class="btn btn-primary w-full">Đăng ký với Google</button>

					<p class="text-sm text-base-content/70">
						Đã có tài khoản?
						<a href="/login" class="link link-primary">Đăng nhập</a>
					</p>
				</div>
			</div>
		</div>
	</main>
	<script is:inline>
		const mainEl = document.querySelector('main[data-register-url]');
		const registerUrl = mainEl?.getAttribute('data-register-url') || '';
		const meUrl = mainEl?.getAttribute('data-me-url') || '';
		const btn = document.getElementById('google-register');

		if (btn) {
			btn.addEventListener('click', () => {
				window.location.href = registerUrl;
			});
		}

		(async () => {
			try {
				const res = await fetch(meUrl, { credentials: 'include' });
				if (!res.ok) return;
				const data = await res.json();
				if (data?.user) window.location.href = '/account';
			} catch {
			}
		})();
	</script>
</Layout>
