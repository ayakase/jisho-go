---
import Layout from '../layouts/Layout.astro';

const apiBase = import.meta.env.PUBLIC_API_BASE_URL?.replace(/\/$/, '') ?? 'http://localhost:8787';
const registerUrl = `${apiBase}/auth/google/start?next=%2Faccount`;
const meUrl = `${apiBase}/auth/me`;
---

<Layout>
	<main class="min-h-screen bg-slate-50 px-6 py-12 text-slate-800" data-register-url={registerUrl} data-me-url={meUrl}>
		<div class="mx-auto w-full max-w-md">
			<a href="/" class="mb-6 inline-flex text-sm text-slate-600 hover:text-slate-900">← Về trang chủ</a>
			<section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
				<h1 class="text-2xl font-bold tracking-[-0.02em]">Register</h1>
				<p class="mt-2 text-sm text-slate-600">Đăng ký nhanh bằng Google. User sẽ được tạo tự động ở lần đăng nhập đầu tiên.</p>

				<button
					id="google-register"
					type="button"
					class="mt-6 inline-flex w-full items-center justify-center rounded-lg border border-rose-400 bg-rose-400 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-rose-500"
				>
					Đăng ký với Google
				</button>

				<p class="mt-4 text-sm text-slate-600">
					Đã có tài khoản?
					<a href="/login" class="font-semibold text-rose-600 hover:text-rose-700">Đăng nhập</a>
				</p>
			</section>
		</div>
	</main>
	<script is:inline>
		const mainEl = document.querySelector('main[data-register-url]');
		const registerUrl = mainEl?.getAttribute('data-register-url') || '';
		const meUrl = mainEl?.getAttribute('data-me-url') || '';
		const btn = document.getElementById('google-register');

		if (btn) {
			btn.addEventListener('click', () => {
				window.location.href = registerUrl;
			});
		}

		(async () => {
			try {
				const res = await fetch(meUrl, { credentials: 'include' });
				if (!res.ok) return;
				const data = await res.json();
				if (data?.user) {
					window.location.href = '/account';
				}
			} catch {
				// no-op
			}
		})();
	</script>
</Layout>
